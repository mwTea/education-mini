/* 数学题型配置页：摘要头 + 模板 + 题型列表 */
.page-wrap {
  min-height: 100vh;
  background: #faf4e8;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

/* 摘要头 */
.sum-card {
  background: linear-gradient(135deg, #7cc0dd, #3f92bb);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.sum-title { color: #fffcf4; font-size: 34rpx; font-weight: 600; }
.sum-row { display: flex; gap: 14rpx; margin-top: 16rpx; flex-wrap: wrap; }
.sum-chip {
  background: rgba(255,255,255,0.22); color: #f2fbff;
  font-size: 22rpx; padding: 6rpx 20rpx; border-radius: 24rpx;
}
.sum-adjust { margin-top: 24rpx; background: rgba(255,255,255,0.14); border-radius: 16rpx; padding: 20rpx 24rpx; }
.adj-item { display: flex; align-items: center; margin-bottom: 16rpx; }
.adj-item:last-child { margin-bottom: 0; }
.adj-label { width: 90rpx; color: #e3f4fc; font-size: 24rpx; flex-shrink: 0; }
.mini-seg { display: flex; flex: 1; gap: 10rpx; }
.mini-seg-item {
  flex: 1; text-align: center; font-size: 24rpx; color: #e9f6fc;
  padding: 10rpx 0; border-radius: 10rpx; background: rgba(255,255,255,0.12);
}
.mini-seg-item.on { background: #fffcf4; color: #2f7fa8; font-weight: 600; }

.card {
  background: #fffdf6;
  border: 2rpx solid #f0e2cc;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.sec-head {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 30rpx; font-weight: 600; color: #3a2e25;
}
.sec-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3f92bb; }
.sec-idx { margin-left: auto; color: #c9bda8; font-size: 24rpx; font-weight: 400; }

/* 模板 */
.preset-row { display: flex; gap: 16rpx; margin-top: 22rpx; }
.preset {
  flex: 1; text-align: center; padding: 20rpx 8rpx;
  border: 2rpx solid #ecd9bd; border-radius: 18rpx; background: #fffaf1;
}
.preset.on { border-color: #3f92bb; background: #eaf5fb; }
.p-name { display: block; font-size: 26rpx; font-weight: 600; color: #3a2e25; }
.preset.on .p-name { color: #2f7fa8; }
.p-sub { display: block; font-size: 20rpx; color: #b3a89d; margin-top: 6rpx; }

/* 题型列表 */
.type-list { margin-top: 20rpx; display: flex; flex-wrap: wrap; gap: 16rpx; }
.type-row {
  display: flex; align-items: center; gap: 14rpx;
  border: 2rpx solid #ecd9bd; border-radius: 16rpx;
  padding: 16rpx 20rpx; background: #fffaf1;
  width: calc((100% - 16rpx) / 2); box-sizing: border-box;
}
.type-row.on { border-color: #3f92bb; background: #eaf5fb; }
.t-check {
  width: 36rpx; height: 36rpx; border-radius: 50%; flex-shrink: 0;
  border: 2rpx solid #d8c9b2; color: #fff; font-size: 22rpx;
  display: flex; align-items: center; justify-content: center;
}
.type-row.on .t-check { background: #3f92bb; border-color: #3f92bb; }
.t-info { display: flex; flex-direction: column; overflow: hidden; }
.t-name { font-size: 25rpx; color: #3a2e25; }
.t-eg { font-size: 20rpx; color: #b3a89d; margin-top: 2rpx; white-space: nowrap; }

.type-actions { display: flex; gap: 36rpx; justify-content: center; margin-top: 24rpx; }
.ta-btn { font-size: 24rpx; color: #2f7fa8; }

.btn-primary {
  background: linear-gradient(135deg, #7cc0dd, #3f92bb);
  color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 44rpx; border: none;
  display: flex; align-items: center; justify-content: center;
  padding: 4rpx 0; margin: 0;
}
.btn-primary::after { border: none; }
.generate { height: 92rpx; }
.quota-tip { text-align: center; color: #c5bab0; font-size: 22rpx; padding: 16rpx 0 4rpx; }
.ad-slot { height: 120rpx; margin-top: 12rpx; }
