/* 关于与隐私：与全站一致的暖橙纸面风格 */
.page-wrap {
  min-height: 100vh;
  background: #f4f1e9;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.brand-card {
  background: linear-gradient(135deg, var(--c-warm-light), var(--c-warm));
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
}

.brand-grid {
  position: relative;
  width: 150rpx;
  height: 150rpx;
  border-radius: 20rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.bg-v, .bg-h {
  position: absolute;
  background: repeating-linear-gradient(90deg, #f09892 0 14rpx, transparent 14rpx 24rpx);
}
.bg-v { left: 50%; top: 10rpx; bottom: 10rpx; width: 3rpx; }
.bg-h { top: 50%; left: 10rpx; right: 10rpx; height: 3rpx;
  background: repeating-linear-gradient(0deg, #f09892 0 14rpx, transparent 14rpx 24rpx); }

.bg-char {
  font-size: 96rpx;
  color: var(--c-text);
  font-family: 'CBKai', 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
  line-height: 1;
}

.brand-name {
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.brand-sub {
  color: var(--c-warm-soft);
  font-size: 24rpx;
  margin-top: 10rpx;
}

.card {
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 24rpx;
  padding: 30rpx 30rpx 24rpx;
  margin-bottom: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 18rpx;
}

.sec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--c-warm);
}

.p {
  font-size: 26rpx;
  color: var(--c-text-sub);
  line-height: 1.8;
  margin-bottom: 10rpx;
}

.feedback-row {
  display: flex;
  justify-content: center;
  padding-top: 10rpx;
}

.feedback-btn {
  margin: 0;
  background: none;
  line-height: 1.8;
  padding: 6rpx 30rpx;
  font-size: 26rpx;
  color: var(--c-text-faint);
  border: 2rpx solid var(--c-line);
  border-radius: 40rpx;
}
.feedback-btn::after { border: none; }
