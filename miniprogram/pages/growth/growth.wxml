<view class="page-wrap">
  <view class="page-title">成长记录</view><view class="page-sub">设备内三科在线练习记录（近 7 天）</view>
  <view class="summary"><view class="summary-title">近 7 天学习</view><view class="metrics"><view><text>{{summary.days}}</text><label>学习天数</label></view><view><text>{{summary.count}}</text><label>完成题数</label></view><view><text>{{summary.rate === null ? '—' : summary.rate + '%'}}</text><label>正确率</label></view></view></view>
  <view class="subject-row"><view class="subject red">语</view><view class="subject-info"><view>语文 · 看拼音选字</view><text>{{subjects.zh.count ? '近7天完成 ' + subjects.zh.count + ' 题' : '还没有练习记录'}}</text></view><view class="rate">{{subjects.zh.rate === null ? '—' : subjects.zh.rate + '%'}}</view></view>
  <view class="subject-row"><view class="subject blue">数</view><view class="subject-info"><view>数学 · 在线口算</view><text>{{subjects.math.count ? '近7天完成 ' + subjects.math.count + ' 题' : '还没有练习记录'}}</text></view><view class="rate">{{subjects.math.rate === null ? '—' : subjects.math.rate + '%'}}</view></view>
  <view class="subject-row"><view class="subject green">英</view><view class="subject-info"><view>英语 · 记词拼单词</view><text>{{subjects.en.count ? '近7天完成 ' + subjects.en.count + ' 词' : '还没有练习记录'}}</text></view><view class="rate">{{subjects.en.rate === null ? '—' : subjects.en.rate + '%'}}</view></view>
  <view class="empty-card"><image class="empty-mascot" src="/assets/mascot/read.png" mode="aspectFit" /><view class="empty-title">每天进步一点点</view><view class="empty-desc">学习日历、轻成就将在成长版本中完善</view><button bindtap="goLearn">去学习</button></view>
</view>
