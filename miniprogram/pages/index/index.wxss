/* 首页：暖橙习字簿 — Hero + 三科入口 + 快捷四格 + 最近 */
.page-wrap {
  min-height: 100vh;
  background: #faf4e8;
  padding: 0 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.page-wrap button::after { border: none; }

/* ── Hero 渐变主卡 ── */
.hero {
  margin: 0 -28rpx;
  padding: 40rpx 36rpx 32rpx;
  background: linear-gradient(160deg, #ffb25c 0%, #ee782c 100%);
  position: relative;
  overflow: hidden;
}
.hero-deco {
  position: absolute; right: -14rpx; top: -30rpx;
  font-size: 260rpx; color: rgba(255,255,255,.08);
  font-family: 'Kaiti SC','STKaiti','KaiTi',serif; line-height: 1;
  pointer-events: none;
}
.hero-badge {
  display: inline-block; background: rgba(255,255,255,.22);
  color: #fff8ee; font-size: 22rpx; padding: 6rpx 20rpx;
  border-radius: 24rpx; margin-bottom: 16rpx;
}
.hero-title { color: #fffcf4; font-size: 48rpx; font-weight: 700; letter-spacing: 2rpx; }
.hero-sub { color: #ffe9d2; font-size: 24rpx; margin-top: 8rpx; }

.hero-demo {
  position: relative; display: flex; gap: 14rpx; margin-top: 28rpx;
}
.hd-cell {
  position: relative; width: 96rpx; height: 96rpx;
  background: #fffcf4; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.hd-v { position: absolute; left: 50%; top: 5rpx; bottom: 5rpx; border-left: 2rpx dashed #f09892; }
.hd-h { position: absolute; top: 50%; left: 5rpx; right: 5rpx; border-top: 2rpx dashed #f09892; }
.hd-char {
  font-size: 56rpx; line-height: 1;
  font-family: 'CBKai','Kaiti SC','STKaiti','KaiTi',serif;
}
.hd-char.demo { color: #3a2e25; }
.hd-char.trace { color: #f09892; }
.hero-seal {
  position: absolute; right: 4rpx; top: -14rpx;
  width: 72rpx; height: 72rpx; border-radius: 12rpx;
  background: #d95f52; color: #fffcf4;
  font-size: 40rpx; font-weight: 700;
  display: flex; align-items: center; justify-content: center;
  transform: rotate(8deg);
  font-family: 'Kaiti SC','STKaiti','KaiTi',serif;
}

.hero-stats {
  display: flex; align-items: center; margin-top: 28rpx;
}
.stat { flex: 1; text-align: center; }
.stat-num { color: #fffcf4; font-size: 36rpx; font-weight: 700; }
.stat-label { color: #ffe9d2; font-size: 22rpx; margin-top: 4rpx; }
.stat-line { width: 2rpx; height: 48rpx; background: rgba(255,255,255,.25); }

/* ── 三学科入口 ── */
.entry-list { margin-top: 24rpx; }
.entry-card {
  position: relative; overflow: hidden; border-radius: 32rpx;
  padding: 36rpx 32rpx; margin-bottom: 20rpx;
  color: #fff; box-shadow: 0 12rpx 32rpx rgba(150,108,60,.15);
}
.entry-card.cn   { background: linear-gradient(135deg, #ffb066 0%, #f08a3c 100%); }
.entry-card.math { background: linear-gradient(135deg, #7cc0dd 0%, #3f92bb 100%); }
.entry-card.en   { background: linear-gradient(135deg, #7cc7a2 0%, #48a273 100%); }

.entry-deco {
  position: absolute; right: 20rpx; top: 50%; transform: translateY(-50%);
  font-size: 150rpx; color: rgba(255,255,255,.16); line-height: 1;
  font-family: 'Kaiti SC','STKaiti','KaiTi',serif; pointer-events: none;
}
.entry-card.en .entry-deco { font-family: Georgia, serif; font-size: 130rpx; }

.entry-head { position: relative; z-index: 1; }
.entry-name { font-size: 36rpx; font-weight: 700; }
.entry-desc { font-size: 24rpx; margin-top: 10rpx; opacity: .85; }

.entry-tags { display: flex; gap: 12rpx; margin-top: 18rpx; position: relative; z-index: 1; }
.etag {
  background: rgba(255,255,255,.22); color: #fff;
  font-size: 20rpx; padding: 6rpx 18rpx; border-radius: 20rpx;
}

/* ── 快捷四格 ── */
.quick-head {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 28rpx; font-weight: 600; color: #3a2e25;
  margin: 28rpx 0 16rpx;
}
.sec-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #f0821e; }
.quick-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.quick-item {
  width: calc((100% - 32rpx) / 2);
  background: #fffdf6; border: 2rpx solid #f0e2cc; border-radius: 20rpx;
  display: flex; align-items: center; gap: 18rpx; padding: 22rpx 24rpx;
  box-sizing: border-box;
}
.q-bubble {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 30rpx; font-weight: 600;
  font-family: 'Kaiti SC','STKaiti','KaiTi',serif;
}
.q-quiz .q-bubble   { background: linear-gradient(135deg, #7cc0dd, #3f92bb); }
.q-name .q-bubble   { background: linear-gradient(135deg, #ffb066, #f0821e); }
.q-radical .q-bubble { background: linear-gradient(135deg, #d9a066, #c07f4e); }
.q-dict .q-bubble   { background: linear-gradient(135deg, #7cc7a2, #48a273); }

.q-label { font-size: 28rpx; font-weight: 600; color: #3a2e25; }
.q-sub { font-size: 20rpx; color: #b3a08b; margin-top: 2rpx; }

/* ── 最近生成 ── */
.recent-head {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 28rpx; font-weight: 600; color: #3a2e25;
  margin: 28rpx 0 8rpx;
}
.recent-item {
  display: flex; align-items: center; gap: 20rpx;
  padding: 20rpx 4rpx; border-bottom: 2rpx solid #ecdfca;
}
.r-tag {
  width: 56rpx; height: 56rpx; border-radius: 14rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 24rpx; font-weight: 600;
}
.r-tag.cn   { background: linear-gradient(135deg, #ffb066, #f08a3c); }
.r-tag.math { background: linear-gradient(135deg, #7cc0dd, #3f92bb); }
.r-tag.en   { background: linear-gradient(135deg, #7cc7a2, #48a273); }

.recent-info { flex: 1; min-width: 0; }
.recent-title {
  font-size: 26rpx; color: #3a2e25;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}
.recent-meta { font-size: 22rpx; color: #b3a08b; margin-top: 4rpx; }
.arrow { color: #c5b6a2; font-size: 34rpx; flex-shrink: 0; }

/* ── 底部 ── */
.feedback-row {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  margin-top: 32rpx; padding-bottom: 8rpx;
}
.feedback-row button {
  margin: 0; padding: 10rpx 20rpx; background: transparent;
  color: #b3a08b; font-size: 24rpx; line-height: 1.5;
}
.dot { color: #d4c6b2; font-size: 24rpx; }
