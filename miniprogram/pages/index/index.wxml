<view class="page-wrap">
  <view class="brand-row"><view><view class="brand">描红习字簿</view><view class="slogan">小学生学习好帮手</view></view><view class="brand-mark">习</view></view>
  <view class="hero">
    <view class="hero-copy"><view class="hero-title">每天进步一点点</view><view class="hero-sub">让练习更简单、更有成就感</view><view class="hero-btn" bindtap="goQuizFast">开始练习</view></view>
    <view class="hero-art"><view class="bubble b1"></view><view class="bubble b2"></view><view class="book">练</view></view>
  </view>
  <view class="section-title">选择学科</view>
  <view class="subject-card red" bindtap="goChinese"><view class="subject-icon">语</view><view class="subject-copy"><view class="subject-name">语文</view><view class="subject-desc">在线练习 · 打印资料</view></view><view class="arrow">›</view></view>
  <view class="subject-card blue" bindtap="goMath"><view class="subject-icon">数</view><view class="subject-copy"><view class="subject-name">数学</view><view class="subject-desc">在线口算 · 同步题卡</view></view><view class="arrow">›</view></view>
  <view class="subject-card green" bindtap="goEnglish"><view class="subject-icon">Abc</view><view class="subject-copy"><view class="subject-name">英语</view><view class="subject-desc">单词书写 · 听写资料</view></view><view class="arrow">›</view></view>
  <view class="quick-grid">
    <view bindtap="goQuizFast"><view class="quick-icon blue-text">练</view><text>在线口算</text></view>
    <view bindtap="goNameSheet"><view class="quick-icon red-text">名</view><text>名字字帖</text></view>
    <view bindtap="goRadicals"><view class="quick-icon orange-text">偏</view><text>偏旁部首</text></view>
    <view bindtap="goHistory"><view class="quick-icon purple-text">史</view><text>打印历史</text></view>
  </view>
  <view wx:if="{{recent.length}}" class="recent-title">最近生成</view>
  <view class="recent-item" wx:for="{{recent}}" wx:key="id" data-id="{{item.id}}" bindtap="openSheet"><view class="recent-dot"></view><view class="recent-info"><view>{{item.title}}</view><text>{{item.pageCount || 1}} 页 · {{item.dateText}}</text></view><view class="arrow">›</view></view>
</view>
