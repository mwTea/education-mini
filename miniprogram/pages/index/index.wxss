/* 首页：暖纸底 + 三科横排 + 四工具 + 最近 */
.home {
  min-height: 100vh;
  background: #faf4e8;
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.home button::after { border: none; }

/* ── 品牌区 ── */
.hero {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 8rpx 28rpx;
}
.hero-title { font-size: 44rpx; font-weight: 700; color: #3a2e25; letter-spacing: 2rpx; }
.hero-sub { margin-top: 8rpx; font-size: 24rpx; color: #b3a08b; }
.hero-seal {
  position: relative; width: 96rpx; height: 96rpx;
  border-radius: 20rpx; background: #fffcf4;
  border: 3rpx solid #d95f52; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center; overflow: hidden;
}
.seal-v { position: absolute; left: 50%; top: 6rpx; bottom: 6rpx; border-left: 2rpx dashed #f09892; }
.seal-h { position: absolute; top: 50%; left: 6rpx; right: 6rpx; border-top: 2rpx dashed #f09892; }
.seal-char { font-size: 54rpx; color: #3a2e25; font-family: 'Kaiti SC','STKaiti','KaiTi',serif; line-height: 1; }

/* ── 三科入口：横排 ── */
.subject-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.sub-card {
  flex: 1; border-radius: 24rpx; padding: 26rpx 8rpx 22rpx;
  display: flex; flex-direction: column; align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(140,95,50,.12);
  position: relative; overflow: hidden;
}
.sub-card.chinese { background: linear-gradient(160deg, #ffb066, #f08a3c); }
.sub-card.math    { background: linear-gradient(160deg, #7cc0dd, #3f92bb); }
.sub-card.english { background: linear-gradient(160deg, #7cc7a2, #48a273); }

.sub-icon {
  position: relative; width: 72rpx; height: 72rpx;
  border-radius: 14rpx; background: rgba(255,255,255,.25);
  display: flex; align-items: center; justify-content: center; margin-bottom: 14rpx;
}
.icon-v { position: absolute; left: 50%; top: 4rpx; bottom: 4rpx; border-left: 2rpx dashed rgba(255,255,255,.35); }
.icon-h { position: absolute; top: 50%; left: 4rpx; right: 4rpx; border-top: 2rpx dashed rgba(255,255,255,.35); }
.icon-char {
  font-size: 40rpx; color: #fff; font-family: 'Kaiti SC','STKaiti','KaiTi',serif; line-height: 1;
}
.icon-char.en { font-family: Georgia, serif; font-size: 32rpx; }
.icon-line { position: absolute; left: 6rpx; right: 6rpx; border-top: 2rpx dashed rgba(255,255,255,.35); }
.icon-line.l1 { top: 14rpx; } .icon-line.l2 { top: 28rpx; } .icon-line.l3 { top: 42rpx; } .icon-line.l4 { top: 56rpx; }

.sub-name { color: #fff; font-size: 30rpx; font-weight: 700; }
.sub-desc { color: rgba(255,255,255,.85); font-size: 20rpx; margin-top: 6rpx; }

/* ── 快捷工具：四宫格 ── */
.tool-row { display: flex; gap: 16rpx; margin-bottom: 28rpx; }
.tool-item {
  flex: 1; background: #fffdf6; border: 2rpx solid #f0e2cc; border-radius: 18rpx;
  display: flex; flex-direction: column; align-items: center; padding: 20rpx 4rpx 16rpx;
}
.tool-icon {
  width: 56rpx; height: 56rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 28rpx; font-weight: 600; margin-bottom: 10rpx;
}
.tool-icon.t1 { background: linear-gradient(135deg, #7cc0dd, #3f92bb); }
.tool-icon.t2 { background: linear-gradient(135deg, #ffb066, #f08a3c); }
.tool-icon.t3 { background: linear-gradient(135deg, #d9a066, #c07f4e); }
.tool-icon.t4 { background: linear-gradient(135deg, #7cc7a2, #48a273); }
.tool-label { font-size: 22rpx; color: #6b5f51; }

/* ── 最近生成 ── */
.recent-head {
  display: flex; align-items: center; gap: 12rpx;
  font-size: 28rpx; font-weight: 600; color: #3a2e25; margin: 4rpx 0 8rpx;
}
.sec-dot { width: 10rpx; height: 10rpx; border-radius: 50%; background: #f0821e; }
.recent-item {
  display: flex; align-items: center; gap: 18rpx; padding: 20rpx 8rpx;
  border-bottom: 2rpx solid #ecdfca;
}
.r-tag {
  width: 56rpx; height: 56rpx; border-radius: 14rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 26rpx; font-weight: 600; color: #fff; flex-shrink: 0;
}
.r-tag.chinese { background: linear-gradient(135deg, #ffb066, #f08a3c); }
.r-tag.math    { background: linear-gradient(135deg, #7cc0dd, #3f92bb); }
.r-tag.english { background: linear-gradient(135deg, #7cc7a2, #48a273); }
.recent-info { flex: 1; min-width: 0; }
.recent-title { font-size: 26rpx; color: #3a2e25; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.recent-meta { font-size: 22rpx; color: #b3a08b; margin-top: 4rpx; }
.arrow { color: #c5b6a2; font-size: 34rpx; flex-shrink: 0; }

/* ── 底部 ── */
.feedback-row {
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  margin-top: 32rpx;
}
.feedback-row button {
  margin: 0; padding: 10rpx 20rpx; background: transparent;
  color: #b3a08b; font-size: 24rpx; line-height: 1.5;
}
.dot { color: #d4c6b2; font-size: 24rpx; }
