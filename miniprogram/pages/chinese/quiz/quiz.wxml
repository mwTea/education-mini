<view class="page-wrap">
  <!-- 选课 -->
  <block wx:if="{{stage === 'pick'}}">
    <view class="head">
      <image class="head-mascot" src="/assets/mascot/read.png" mode="aspectFit" />
      <view><view class="head-title">看拼音选字</view><view class="head-sub">{{bookName}}</view></view>
    </view>
    <view class="seg">
      <view class="seg-item {{sem === 'a' ? 'on' : ''}}" data-sem="a" bindtap="onSemTap">{{grade}}年级上册</view>
      <view class="seg-item {{sem === 'b' ? 'on' : ''}}" data-sem="b" bindtap="onSemTap">{{grade}}年级下册</view>
    </view>
    <view wx:if="{{outdated}}" class="outdated-tip">课本注音数据待更新：本地请启动最新 backend 并使用本地地址，线上需部署后再试</view>
    <view wx:if="{{loading}}" class="loading">课本加载中…</view>
    <view wx:for="{{lessons}}" wx:key="title" class="lesson-card" data-index="{{index}}" bindtap="onLessonTap">
      <view class="lesson-info"><view class="lesson-title">{{item.title}}</view><view class="lesson-count">{{item.count}} 个生字</view></view>
      <view class="lesson-go">开始</view>
    </view>
  </block>

  <!-- 答题 -->
  <block wx:if="{{stage === 'quiz'}}">
    <view class="quiz-top">
      <view class="back" bindtap="backToPick">‹ 换课</view>
      <view class="progress-text">{{idx + 1}} / {{total}}</view>
      <view class="quiz-right">
        <view class="score-chip">得分 {{score}}</view>
        <view class="submit-btn" bindtap="onSubmit">交卷</view>
      </view>
    </view>
    <view class="progress-bar"><view class="progress-fill" style="width: {{(idx + 1) * 100 / total}}%"></view></view>
    <view class="py-card">
      <view class="py-label">读一读，选出生字</view>
      <view class="py-text">{{cur.py}}</view>
    </view>
    <view class="opt-grid">
      <view
        wx:for="{{cur.options}}" wx:key="*this"
        class="opt {{chosen === index ? (feedback === 'right' ? 'right' : 'wrong') : ''}} {{feedback === 'wrong' && item === cur.answer && chosen !== index ? 'answer' : ''}}"
        data-index="{{index}}" bindtap="onOptTap">{{item}}</view>
    </view>
  </block>

  <!-- 结算 -->
  <block wx:if="{{stage === 'done'}}">
    <view class="done-card">
      <image class="done-mascot" src="{{rate >= 80 ? '/assets/mascot/cheer.png' : '/assets/mascot/encourage.png'}}" mode="aspectFit" />
      <view class="done-stars">{{stars}}</view>
      <view class="done-score">{{score}} / {{total}}</view>
      <view class="done-words">{{words}}</view>
      <view wx:if="{{wrongChars.length}}" class="wrong-box">
        <view class="wrong-title">再看看这些字</view>
        <view class="wrong-chars"><text wx:for="{{wrongChars}}" wx:key="*this">{{item}}</text></view>
      </view>
      <view class="done-btns">
        <view class="btn-ghost done-btn" bindtap="onRetry">再练一次</view>
        <view class="btn-primary done-btn" bindtap="backToPick">换一课</view>
      </view>
    </view>
  </block>
</view>
