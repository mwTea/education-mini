.page-wrap{min-height:100vh;padding:36rpx 28rpx 60rpx;box-sizing:border-box}.page-title{font-size:44rpx;font-weight:700;color:#0f2b70}.page-sub{font-size:25rpx;color:#64748b;margin:10rpx 0 28rpx}.summary{background:linear-gradient(135deg,#eff6ff,#f5f3ff);border:2rpx solid #dbeafe;border-radius:26rpx;padding:30rpx}.summary-title{font-size:28rpx;font-weight:650;color:#1e3a8a}.metrics{display:flex;margin-top:28rpx}.metrics view{flex:1;text-align:center}.metrics text{display:block;font-size:38rpx;font-weight:700;color:#1d4ed8}.metrics label{display:block;font-size:21rpx;color:#64748b;margin-top:6rpx}.subject-row{display:flex;align-items:center;background:#fff;border:2rpx solid #e8eef7;border-radius:20rpx;padding:22rpx;margin-top:16rpx}.subject{width:60rpx;height:60rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}.red{background:#f56c6c}.blue{background:#3b82f6}.green{background:#10b981}.subject-info{flex:1;margin-left:18rpx;font-size:27rpx}.subject-info text{display:block;font-size:21rpx;color:#94a3b8;margin-top:5rpx}.pending{font-size:21rpx;color:#94a3b8}.rate{color:#2563eb;font-size:28rpx;font-weight:700}.empty-card{text-align:center;margin-top:28rpx;background:#fff;border:2rpx solid #e8eef7;border-radius:24rpx;padding:34rpx}.empty-icon{font-size:48rpx;color:#3b82f6}.empty-title{font-size:28rpx;font-weight:650;margin-top:10rpx}.empty-desc{font-size:22rpx;color:#94a3b8;margin-top:8rpx}.empty-card button{width:220rpx;margin-top:24rpx;border-radius:999rpx;background:#2687f5;color:#fff;font-size:25rpx}.empty-card button::after{border:0}
