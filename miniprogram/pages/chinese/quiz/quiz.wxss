/* 语文·看拼音选字：选课列表 → 大拼音卡四选一 → 结算。学科红点缀。 */
.page-wrap{min-height:100vh;padding:32rpx 28rpx 60rpx;box-sizing:border-box}

.head{display:flex;align-items:center;gap:20rpx;margin-bottom:26rpx}
.head-mascot{width:120rpx;height:110rpx;flex-shrink:0}
.head-title{font-size:40rpx;font-weight:700;color:#12305e}
.head-sub{font-size:23rpx;color:var(--c-text-sub);margin-top:6rpx}

.book-picker{margin-bottom:24rpx}
.picker-label{font-size:25rpx;font-weight:600;color:#12305e;margin-bottom:16rpx}
.grade-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14rpx;margin-bottom:20rpx}
.book-picker .grade-chip{width:100%;margin:0;padding:18rpx 4rpx;min-width:0;border-radius:18rpx;background:#fff;color:var(--c-text-sub);font-size:26rpx;line-height:1.5;border:2rpx solid transparent}
.grade-chip.on{background:var(--c-chinese-soft);color:#ba3e38;border-color:var(--c-chinese);font-weight:600}
.seg{display:flex;background:#edeae1;border-radius:20rpx;padding:6rpx}
.book-picker .seg-item{width:0;flex:1;min-width:0;margin:0;background:transparent;text-align:center;font-size:26rpx;line-height:1.5;color:var(--c-text-sub);border-radius:16rpx;padding:16rpx 0;transition:all 0.2s}
.seg-item.on{background:var(--bg-card);color:var(--c-chinese);font-weight:600;box-shadow:0 4rpx 12rpx rgba(31,41,55,.1)}

.loading{text-align:center;color:var(--c-text-faint);font-size:24rpx;padding:60rpx 0}
.load-error{text-align:center;color:var(--c-text-sub);font-size:26rpx;padding:40rpx 0}
.reload-btn{display:inline-block;margin-top:20rpx;padding:16rpx 36rpx;border-radius:999rpx;font-size:26rpx;line-height:1.5;background:var(--c-chinese-soft);color:#ba3e38}
.outdated-tip{background:var(--c-warm-soft);border-left:6rpx solid var(--c-warm);border-radius:0 14rpx 14rpx 0;padding:16rpx 20rpx;color:#9a5b21;font-size:22rpx;line-height:1.6;margin-bottom:18rpx}

.lesson-card{display:flex;align-items:center;background:var(--bg-card);border-radius:var(--r-card);padding:24rpx 26rpx;margin-bottom:14rpx;box-shadow:var(--shadow-card)}
.lesson-info{flex:1;min-width:0}
.lesson-title{font-size:28rpx;font-weight:600;color:var(--c-text)}
.lesson-count{font-size:21rpx;color:var(--c-text-faint);margin-top:6rpx}
.lesson-go{padding:12rpx 26rpx;border-radius:999rpx;background:linear-gradient(135deg,#ff8f6b,var(--c-chinese));color:#fff;font-size:23rpx;font-weight:600;box-shadow:0 6rpx 16rpx rgba(245,108,108,.28);flex-shrink:0}

.quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.back{font-size:26rpx;color:var(--c-text-sub);padding:8rpx 12rpx 8rpx 0}
.progress-text{font-size:25rpx;color:var(--c-text-sub)}
.score-chip{font-size:22rpx;color:var(--c-chinese);background:var(--c-chinese-soft);border-radius:999rpx;padding:8rpx 20rpx;font-weight:600}
.quiz-right{display:flex;align-items:center;gap:12rpx}
.submit-btn{font-size:22rpx;color:var(--c-chinese);border:2rpx solid currentColor;border-radius:999rpx;padding:4rpx 18rpx}

.progress-bar{height:12rpx;background:#edeae1;border-radius:999rpx;overflow:hidden}
.progress-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#ff8f6b,var(--c-chinese));transition:width 0.25s}

.py-card{margin-top:36rpx;background:linear-gradient(160deg,#fff6f5,#ffe9e7);border-radius:var(--r-card);padding:56rpx 32rpx;text-align:center;box-shadow:var(--shadow-card)}
.py-label{font-size:23rpx;color:var(--c-text-sub)}
.py-text{font-size:96rpx;font-weight:700;color:#8f3a2e;margin-top:18rpx;letter-spacing:4rpx;line-height:1.2}

.opt-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:30rpx}
.opt{height:170rpx;background:var(--bg-card);border-radius:var(--r-card);border:3rpx solid transparent;display:flex;align-items:center;justify-content:center;font-size:76rpx;font-weight:600;color:var(--c-text);font-family:'Kaiti SC','STKaiti','KaiTi',serif;box-shadow:var(--shadow-card)}
.opt.right{background:#ecfdf5;border-color:var(--c-success);color:var(--c-success)}
.opt.wrong{background:#fef2f2;border-color:var(--c-error);color:var(--c-error)}
.opt.answer{border-color:var(--c-success);color:var(--c-success)}

.done-card{margin-top:40rpx;background:var(--bg-card);border-radius:var(--r-card);padding:48rpx 36rpx;text-align:center;box-shadow:var(--shadow-card)}
.done-mascot{width:180rpx;height:160rpx}
.done-stars{font-size:44rpx;margin-top:12rpx}
.done-score{font-size:56rpx;font-weight:750;color:#12305e;margin-top:10rpx}
.done-words{font-size:25rpx;color:var(--c-text-sub);margin-top:10rpx}
.wrong-box{margin-top:30rpx;background:var(--c-chinese-soft);border-radius:20rpx;padding:22rpx}
.wrong-title{font-size:22rpx;color:var(--c-text-sub)}
.wrong-chars{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:14rpx;justify-content:center}
.wrong-chars text{width:72rpx;height:72rpx;background:#fff;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:600;color:#8f3a2e;font-family:'Kaiti SC','STKaiti','KaiTi',serif}
.done-btns{display:flex;gap:18rpx;margin-top:36rpx}
.done-btn{flex:1;height:88rpx}
