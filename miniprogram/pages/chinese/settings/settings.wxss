page{background:#f3f7fc}
.settings-page{min-height:100vh;padding:24rpx 24rpx 160rpx;box-sizing:border-box;color:#1f2937}
.settings-intro{padding:10rpx 8rpx 22rpx}.intro-title{font-size:34rpx;font-weight:700;color:#173260}.intro-sub{margin-top:8rpx;font-size:23rpx;color:#64748b;line-height:1.5}
.setting-card,.preview-card{margin-bottom:20rpx;padding:28rpx;background:#fff;border-radius:28rpx;box-shadow:0 8rpx 24rpx rgba(32,76,116,.06)}
.setting-card.compact{display:flex;align-items:center;justify-content:space-between;gap:24rpx}
.setting-head{display:flex;align-items:center;gap:12rpx;margin-bottom:22rpx;font-size:29rpx;font-weight:700;color:#1f2937}.head-dot{width:12rpx;height:12rpx;border-radius:4rpx;background:#3b82f6}.count-head .count-badge{margin-left:auto;padding:6rpx 16rpx;border-radius:999rpx;background:#fef2f2;color:#f56c6c;font-size:22rpx;font-weight:600}
.choice-row{display:grid;gap:16rpx}.two-col{grid-template-columns:repeat(2,minmax(0,1fr))}.three-col{grid-template-columns:repeat(3,minmax(0,1fr))}
.choice-tile,.grid-tile{min-width:0;border:3rpx solid transparent;background:#f5f7fb;border-radius:20rpx;box-sizing:border-box;color:#64748b}.choice-tile{display:flex;align-items:center;gap:14rpx;padding:18rpx}.grid-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12rpx;padding:18rpx 8rpx;font-size:24rpx}
.choice-tile.on,.grid-tile.on{border-color:#f56c6c;background:#fff4f4;color:#f56c6c;box-shadow:0 6rpx 16rpx rgba(245,108,108,.12)}
.font-sample,.paper-sample{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:66rpx;height:66rpx;border:2rpx solid #e6dfd3;border-radius:12rpx;background:#fff;font-size:43rpx;color:#1f2937}.font-sample.kai{font-family:'CBKai','Kaiti SC','STKaiti',serif}.font-sample.xing{font-family:'CBXing','STXingkai','Kaiti SC',serif}.paper-sample{border-color:#5b9e7d;color:#f09892;font-family:'CBKai','Kaiti SC',serif}.paper-sample.simple{border-color:#94a3b8;color:#cbd5e1}
.choice-name{font-size:25rpx;font-weight:650;line-height:1.3}.choice-sub{margin-top:5rpx;color:#94a3b8;font-size:19rpx;line-height:1.35}.choice-tile.on .choice-sub{color:#d46a6a}
.mini-grid{position:relative;width:54rpx;height:54rpx;border:3rpx solid #5b9e7d;border-radius:7rpx;background:#fff;box-sizing:border-box;overflow:hidden}.mini-grid.plain{border-color:#7f878e}.line-v,.cell-v{position:absolute;left:50%;top:0;bottom:0;border-left:2rpx dashed #a8cbb6}.line-h,.cell-h{position:absolute;top:50%;left:0;right:0;border-top:2rpx dashed #a8cbb6}.line-d,.cell-d{position:absolute;left:50%;top:50%;width:142%;border-top:2rpx dashed #a8cbb6;transform:translate(-50%,-50%) rotate(45deg)}.line-d.d2,.cell-d.d2{transform:translate(-50%,-50%) rotate(-45deg)}
.switch-title{font-size:28rpx;font-weight:700}.switch-sub{margin-top:7rpx;font-size:22rpx;color:#94a3b8}
.trace-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12rpx}.trace-chip{height:64rpx;border:2rpx solid transparent;border-radius:16rpx;background:#f1f5f9;color:#64748b;font-size:25rpx;display:flex;align-items:center;justify-content:center}.trace-chip.on{border-color:#f56c6c;background:#fff2f2;color:#f56c6c;font-weight:700}.setting-note{margin-top:18rpx;font-size:21rpx;line-height:1.5;color:#94a3b8}
.preview-card{padding:26rpx}.preview-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:18rpx;font-size:28rpx;font-weight:700}.preview-meta{font-size:21rpx;color:#94a3b8;font-weight:400}.practice-preview{padding:18rpx;border-radius:18rpx;background:#fbfffd}.practice-preview.simple{background:#f8fafc}.preview-pinyin{padding-left:4rpx;margin-bottom:4rpx;font-size:19rpx;color:#334155}.preview-cells{display:flex;overflow:hidden}.practice-cell{position:relative;width:16.666%;height:96rpx;border:2rpx solid #5b9e7d;border-right:0;box-sizing:border-box}.practice-cell:last-child{border-right:2rpx solid #5b9e7d}.simple .practice-cell{border-color:#94a3b8}.preview-char{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:48rpx;line-height:1;font-family:'CBKai','Kaiti SC','STKaiti',serif}.preview-char.xing{font-family:'CBXing','STXingkai','Kaiti SC',serif}.preview-char.demo{color:#20262e}.preview-char.trace{color:#f09892}.simple .preview-char.trace{color:#cbd5e1}.summary{margin-top:14rpx;font-size:20rpx;color:#64748b;line-height:1.5}
.save-bar{position:fixed;left:0;right:0;bottom:0;padding:18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom));background:rgba(255,255,255,.96);border-top:1rpx solid #e8eef5;z-index:10}.save-btn{width:100%;height:88rpx;font-size:30rpx}.settings-spacer{height:20rpx}
