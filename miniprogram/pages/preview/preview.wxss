.preview-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #eef2f7;
}

.success-hero {
  display: flex;
  align-items: center;
  min-height: 180rpx;
  padding: 12rpx 32rpx 8rpx;
  background: linear-gradient(135deg, #edf7ff, #fff7ed);
  box-sizing: border-box;
}

.success-mascot {
  width: 230rpx;
  height: 166rpx;
  flex-shrink: 0;
}

.success-copy {
  margin-left: 14rpx;
}

.success-title {
  color: #173260;
  font-size: 31rpx;
  font-weight: 700;
}

.success-sub {
  margin-top: 8rpx;
  color: #64748b;
  font-size: 22rpx;
}

/* 顶部信息条 */
.info-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.92);
  border-bottom: 2rpx solid var(--c-line);
}

.r-tag {
  width: 60rpx;
  height: 60rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  flex-shrink: 0;
  font-family: 'Kaiti SC', serif;
}

.r-tag.cn {
  background: var(--c-chinese-soft);
  color: var(--c-chinese);
}

.r-tag.en {
  background: #dcfce7;
  color: var(--c-success);
}

.info-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ichip {
  background: #fff;
  border: 2rpx solid var(--c-line);
  color: var(--c-text-sub);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  font-size: 22rpx;
}

.preview-scroll {
  flex: 1;
  min-height: 0;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 纸张容器 + 印章 */
.sheet-wrap {
  position: relative;
}

.sheet-seal {
  position: absolute;
  right: 16rpx;
  top: 12rpx;
  z-index: 5;
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  background: var(--c-error);
  color: #fff;
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: 'Kaiti SC', serif;
  transform: rotate(12deg);
  opacity: 0.92;
  box-shadow: 0 8rpx 18rpx rgba(239, 68, 68, 0.3);
}

.print-tip {
  text-align: center;
  color: var(--c-text-faint);
  font-size: 24rpx;
  padding: 16rpx 0 24rpx;
}

.print-tip.sub {
  padding-top: 0;
  margin-top: -12rpx;
  font-size: 22rpx;
  color: var(--c-text-faint);
}

/* 底部操作：主按钮 + 次按钮行 */
.preview-footer {
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 2rpx solid var(--c-line);
}

.footer-main {
  width: 100%;
}

.footer-side {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.footer-side button {
  flex: 1;
  height: 76rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.state {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--c-text-faint);
}

.state.error {
  color: var(--c-error);
  padding: 0 60rpx;
  text-align: center;
  white-space: pre-line;
  line-height: 1.8;
}

.pdf-caption {
  text-align: center;
  color: var(--c-text-faint);
  font-size: 22rpx;
  padding-top: 12rpx;
}

.r-tag.math { background: var(--c-primary); }
