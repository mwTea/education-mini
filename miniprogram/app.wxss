/* V2 公共视觉：清爽蓝色主调，语数英使用各自学科色。 */
page {
  background-color: #f8fafc;
  color: #1f2937;
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

button::after {
  border: none;
}

/* 主按钮：暖橙渐变 + 投影 */
.btn-primary {
  background: linear-gradient(135deg, #3b82f6 0%, #1688f8 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.24);
}

.btn-ghost {
  background: #fff;
  color: #3b82f6;
  border: 2rpx solid #bfdbfe;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.danger {
  color: #d9534f;
  border-color: #f2c4c0;
}

/* 通用卡片 */
.card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.06);
}

/* 区块标题：色点 + 标题 */
.sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
}

.sec-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, #3b82f6, #1688f8);
}

/* 分段控制器 */
.seg {
  display: flex;
  background: #eef2f7;
  border-radius: 20rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  border-radius: 16rpx;
  padding: 14rpx 0;
  transition: all 0.2s;
}

.seg-item.on {
  background: #fff;
  color: #2563eb;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(150, 108, 60, 0.12);
}

/* 迷你田字格（选择器预览用） */
.mini-grid {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #5b9e7d;
  border-radius: 6rpx;
  box-sizing: border-box;
  background: #fff;
}

.mg-v {
  position: absolute;
  left: 50%;
  top: 2rpx;
  bottom: 2rpx;
  border-left: 2rpx dashed #a8cbb6;
}

.mg-h {
  position: absolute;
  top: 50%;
  left: 2rpx;
  right: 2rpx;
  border-top: 2rpx dashed #a8cbb6;
}

.mg-d1,
.mg-d2 {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96%;
  height: 0;
  border-top: 2rpx dashed #a8cbb6;
  transform: translate(-50%, -50%) rotate(45deg);
}

.mg-d2 {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.mg-fang {
  border-color: #7f878e;
}

.mg-fang .mg-v,
.mg-fang .mg-h {
  border-color: transparent;
}
