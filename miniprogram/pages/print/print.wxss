/* 打印页：暖色氛围 Hero + 渐变学科图标 + 白卡投影工具格。 */
.page-wrap{min-height:100vh;padding:36rpx 28rpx 60rpx;box-sizing:border-box}
.page-title{font-size:44rpx;font-weight:700;color:#12305e}
.page-sub{font-size:25rpx;color:var(--c-text-sub);margin:10rpx 0 28rpx}
.hero{display:flex;justify-content:space-between;align-items:center;padding:30rpx;background:linear-gradient(135deg,var(--c-warm-soft),#ffedd5);border-radius:var(--r-card);margin-bottom:24rpx}
.hero-title{font-size:30rpx;font-weight:650;color:#c2410c}
.hero-sub{font-size:23rpx;color:#9a6a4b;margin-top:8rpx}
.paper{width:82rpx;height:96rpx;background:#fff;border-radius:8rpx;box-shadow:0 8rpx 18rpx rgba(154,80,20,.13);display:flex;align-items:center;justify-content:center;color:var(--c-warm);font-size:21rpx;font-weight:700}
.print-card{display:flex;align-items:center;background:var(--bg-card);border-radius:var(--r-card);padding:24rpx;margin-bottom:16rpx;box-shadow:var(--shadow-card)}
.icon{width:76rpx;height:76rpx;border-radius:20rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:29rpx}
.red{background:linear-gradient(135deg,#ff8f6b,var(--c-chinese));box-shadow:0 8rpx 18rpx rgba(245,108,108,.3)}
.blue{background:linear-gradient(135deg,#6ea8ff,var(--c-math));box-shadow:0 8rpx 18rpx rgba(59,130,246,.3)}
.green{background:linear-gradient(135deg,#5fd6ad,var(--c-english));box-shadow:0 8rpx 18rpx rgba(16,185,129,.3)}
.copy{flex:1;margin-left:20rpx}
.name{font-size:29rpx;font-weight:650;color:var(--c-text)}
.desc{font-size:22rpx;color:var(--c-text-sub);margin-top:6rpx}
.arrow{font-size:42rpx;color:var(--c-text-faint)}
.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}
.tool{background:var(--bg-card);border-radius:var(--r-tile);padding:24rpx;display:flex;align-items:center;gap:16rpx;font-size:25rpx;color:var(--c-text);box-shadow:var(--shadow-card)}
.tool-icon{width:58rpx;height:58rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;font-weight:700}
.red-text{color:var(--c-chinese);background:var(--c-chinese-soft)}
.orange{color:var(--c-warn);background:#fffbeb}
.purple{color:#8b5cf6;background:#f5f3ff}
.blue-text{color:var(--c-primary-ink);background:var(--c-primary-soft)}
