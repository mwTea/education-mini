/* 成长页：蓝紫汇总卡 + 渐变学科行 + 小墨空态。 */
.page-wrap{min-height:100vh;padding:36rpx 28rpx 60rpx;box-sizing:border-box}
.page-title{font-size:44rpx;font-weight:700;color:#12305e}
.page-sub{font-size:25rpx;color:var(--c-text-sub);margin:10rpx 0 28rpx}
.summary{background:linear-gradient(135deg,#eff6ff,#ede9fe);border-radius:var(--r-card);padding:30rpx}
.summary-title{font-size:28rpx;font-weight:650;color:#1e3a8a}
.metrics{display:flex;margin-top:28rpx}
.metrics view{flex:1;text-align:center}
.metrics text{display:block;font-size:38rpx;font-weight:700;color:var(--c-primary-ink)}
.metrics label{display:block;font-size:21rpx;color:var(--c-text-sub);margin-top:6rpx}
.subject-row{display:flex;align-items:center;background:var(--bg-card);border-radius:var(--r-card);padding:22rpx;margin-top:16rpx;box-shadow:var(--shadow-card)}
.subject{width:60rpx;height:60rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700}
.red{background:linear-gradient(135deg,#ff8f6b,var(--c-chinese))}
.blue{background:linear-gradient(135deg,#6ea8ff,var(--c-math))}
.green{background:linear-gradient(135deg,#5fd6ad,var(--c-english))}
.subject-info{flex:1;margin-left:18rpx;font-size:27rpx;color:var(--c-text)}
.subject-info text{display:block;font-size:21rpx;color:var(--c-text-faint);margin-top:5rpx}
.pending{font-size:21rpx;color:var(--c-text-faint)}
.rate{color:var(--c-primary-ink);font-size:28rpx;font-weight:700}
.empty-card{text-align:center;margin-top:28rpx;background:var(--bg-card);border-radius:var(--r-card);padding:34rpx;box-shadow:var(--shadow-card)}
.empty-mascot{width:150rpx;height:130rpx}
.empty-title{font-size:28rpx;font-weight:650;margin-top:10rpx;color:var(--c-text)}
.empty-desc{font-size:22rpx;color:var(--c-text-faint);margin-top:8rpx}
.empty-card button{width:220rpx;margin-top:24rpx;border-radius:999rpx;background:linear-gradient(135deg,var(--c-primary),var(--c-primary-deep));color:#fff;font-size:25rpx;box-shadow:0 8rpx 18rpx rgba(59,130,246,.3)}
.empty-card button::after{border:0}
