.page-wrap { min-height: 100vh; background: #f4f1e9; padding: 24rpx 32rpx 60rpx; box-sizing: border-box; }
.quiz-active { padding-bottom: calc(620rpx + env(safe-area-inset-bottom)); }
.quiz-active .q-stem { overflow-wrap: anywhere; margin: 24rpx 0; line-height: 1.5; }
.wrong-item { gap: 20rpx; flex-wrap: wrap; }
.progress { height: 10rpx; background: #eef2f7; border-radius: 5rpx; overflow: hidden; }
.pg-bar { height: 100%; background: var(--c-primary); transition: width .2s; }
.q-meta { text-align: center; color: #94a3b8; font-size: 22rpx; margin: 20rpx 0 40rpx; }
.q-stem { text-align: center; font-size: 72rpx; color: var(--c-text); font-weight: 600; margin: 60rpx 0; }
.ans-row { display: flex; justify-content: center; margin-bottom: 60rpx; }
.ans-box {
  min-width: 260rpx; text-align: center; font-size: 56rpx; color: var(--c-text);
  border-bottom: 6rpx solid var(--c-text-faint); padding: 10rpx 30rpx;
}
.ans-box.right { color: var(--c-success); border-color: var(--c-success); }
.ans-box.wrong { color: var(--c-error); border-color: var(--c-error); }
.keypad { display: flex; flex-wrap: wrap; gap: 18rpx; }
.key {
  width: calc((100% - 24rpx) / 3); height: 104rpx; background: #fff;
  border: 2rpx solid var(--c-line); border-radius: 18rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 40rpx; color: var(--c-text); box-sizing: border-box;
}
.key.func { color: var(--c-text-sub); font-size: 30rpx; }
.key.ok { background: var(--c-primary); color: #fff; border-color: var(--c-primary); font-size: 30rpx; }
.result-card { background: linear-gradient(135deg, #6ea8ff, var(--c-primary)); border-radius: 24rpx; padding: 60rpx 32rpx; text-align: center; margin-bottom: 24rpx; }
.r-score { color: #fff; font-size: 110rpx; font-weight: 700; }
.r-total { font-size: 40rpx; }
.r-sub { color: var(--c-primary-soft); font-size: 26rpx; margin-top: 12rpx; }
.card { background: #fff; border: 2rpx solid var(--c-line); border-radius: 24rpx; padding: 30rpx; margin-bottom: 24rpx; }
.sec-head { display: flex; align-items: center; gap: 12rpx; font-size: 30rpx; font-weight: 600; color: var(--c-text); }
.sec-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--c-primary); }
.wrong-item { display: flex; justify-content: space-between; padding: 18rpx 0; border-bottom: 2rpx solid #f4f1e9; font-size: 28rpx; }
.w-stem { color: var(--c-text); }
.w-ans { color: var(--c-error); }
.btn-primary { background: linear-gradient(135deg, #6ea8ff, var(--c-primary)); color: #fff; font-size: 30rpx; font-weight: 600; border-radius: 44rpx; border: none; display: flex; align-items: center; justify-content: center; padding: 4rpx 0; margin: 0; height: 92rpx; }
.btn-primary::after { border: none; }
.btn-ghost2 { margin-top: 20rpx; background: none; border: 2rpx solid #bfdbfe; color: var(--c-primary-ink); border-radius: 44rpx; font-size: 28rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; }
.btn-ghost2::after { border: none; }

/* 开始页 / 顶栏 / 键盘第四行 / 结算升级 */
.start-card { background: #fff; border: 2rpx solid var(--c-line); border-radius: 24rpx; padding: 48rpx 32rpx; text-align: center; }
.s-title { font-size: 34rpx; font-weight: 700; color: var(--c-text); }
.s-sub { font-size: 22rpx; color: var(--c-text-faint); margin: 10rpx 0 36rpx; }
.s-label { font-size: 26rpx; color: var(--c-text-sub); margin-bottom: 16rpx; }
.seg { display: flex; background: #f4f1e9; border-radius: 16rpx; padding: 6rpx; gap: 8rpx; }
.seg-item { flex: 1; text-align: center; font-size: 26rpx; color: var(--c-text-sub); padding: 16rpx 0; border-radius: 12rpx; }
.seg-item.on { background: var(--c-primary); color: #fff; font-weight: 600; }
.start-card .btn-primary { margin-top: 36rpx; height: 92rpx; }
.topbar { display: flex; align-items: center; gap: 16rpx; margin: 20rpx 0 30rpx; }
.progress { flex: 1; height: 10rpx; background: #eef2f7; border-radius: 5rpx; overflow: hidden; }
.q-meta { color: var(--c-primary-ink); font-size: 26rpx; font-weight: 600; }
.q-timer { color: #94a3b8; font-size: 24rpx; min-width: 56rpx; text-align: right; }
.q-timer.slow { color: var(--c-error); }
.submit-btn { font-size: 22rpx; color: var(--c-primary); border: 2rpx solid currentColor; border-radius: 999rpx; padding: 4rpx 18rpx; flex-shrink: 0; }
.keypad { position: fixed; left: 24rpx; right: 24rpx; bottom: calc(24rpx + env(safe-area-inset-bottom)); display: flex; flex-wrap: wrap; gap: 12rpx; }
.key.wide { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
.key.func { font-size: 26rpx; color: var(--c-text-sub); }
.r-stars { font-size: 64rpx; letter-spacing: 12rpx; }
.r-words { color: var(--c-primary-soft); font-size: 28rpx; margin-top: 8rpx; }
.r-chips { display: flex; gap: 16rpx; margin-top: 36rpx; }
.chip { flex: 1; background: rgba(255,255,255,0.18); border-radius: 16rpx; padding: 20rpx 0; }
.c-num { color: #fff; font-size: 40rpx; font-weight: 700; }
.c-lbl { color: var(--c-primary-soft); font-size: 22rpx; margin-top: 6rpx; }

.bk {
  width: calc((100% - 36rpx) / 4); padding: 12rpx 0; text-align: center;
  font-size: 24rpx; color: var(--c-text-sub); background: #f4f1e9;
  border: 2rpx solid var(--c-line); border-radius: 10rpx; box-sizing: border-box;
}
.bk.on { background: var(--c-primary); color: #fff; border-color: var(--c-primary); }
.book-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.s-title { font-size: 40rpx; }

.row2 { display: flex; gap: 12rpx; width: 100%; }
.key.half { width: calc((100% - 12rpx) / 2); font-size: 30rpx; }
.key.draft { color: var(--c-primary-ink); background: var(--c-primary-soft); border-color: #bfdbfe; }
.draft-mask {
  position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 10;
  background: rgba(255, 255, 255, 0.92);
}
.draft-cv { width: 100%; height: 100%; }
.draft-bar {
  position: absolute; bottom: calc(30rpx + env(safe-area-inset-bottom));
  left: 0; right: 0; display: flex; justify-content: center; gap: 24rpx;
}
.d-act {
  background: #fff; border: 2rpx solid var(--c-line); color: var(--c-text-sub);
  font-size: 26rpx; padding: 16rpx 44rpx; border-radius: 40rpx;
}
.d-act.primary { background: var(--c-primary); border-color: var(--c-primary); color: #fff; }
