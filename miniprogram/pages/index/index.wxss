/* 首页：小墨场景 → 在线练习 → 同步打印 → 最近生成。 */
page{background:#f3f7fc}
.page-wrap{min-height:100vh;color:#12305e;padding-bottom:40rpx;box-sizing:border-box}
.hero{position:relative;height:316rpx;background:#d9f2ff;overflow:hidden}
.hero-banner{display:block;width:100%;height:100%}
.home-content{position:relative;margin-top:-24rpx;padding:0 24rpx}
.section-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:20rpx}
.section-title{font-size:36rpx;line-height:1.4;font-weight:700;letter-spacing:1rpx}
.practice-panel{padding:30rpx 0 28rpx;background:#fff;border-radius:36rpx;box-shadow:0 8rpx 26rpx rgba(32,76,116,.05)}
.practice-panel .section-head{padding:0 28rpx}
.today-count{font-size:24rpx;color:#64748b;white-space:nowrap}
.today-count text{font-size:36rpx;line-height:1;font-weight:700;color:#1688f8}
.today-progress{height:14rpx;margin:0 28rpx 16rpx;border-radius:999rpx;background:#e5eef7;overflow:hidden}
.today-progress-bar{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#4a9eff,#1688f8);transition:width .3s}
.page-wrap button{margin:0;padding:0;border-radius:0;border:0;background:transparent;font-family:inherit;font-weight:400;line-height:1.4;text-align:left;color:inherit}
.page-wrap button::after{border:0}
.page-wrap .practice-row{display:flex;align-items:center;gap:20rpx;width:auto;margin:0 28rpx 18rpx;padding:20rpx 24rpx;border-radius:24rpx;box-sizing:border-box}
.practice-row:last-child{margin-bottom:0}
.page-wrap .practice-row.chinese{background:#fff1eb}
.page-wrap .practice-row.math{background:#eaf5ff}
.page-wrap .practice-row.english{background:#eaf9f0}
.practice-row.chinese .practice-arrow{background:#ffe4d6}
.practice-row.math .practice-arrow{background:#d6ecff}
.practice-row.english .practice-arrow{background:#d7f2e2}
.practice-icon-wrap{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:80rpx;height:80rpx}
.practice-icon-img{width:68rpx;height:68rpx}
.practice-text{flex:1;min-width:0}
.practice-subject{font-size:30rpx;font-weight:700;line-height:1.4}
.practice-row.chinese .practice-subject{color:#c83f39}
.practice-row.math .practice-subject{color:#2262cc}
.practice-row.english .practice-subject{color:#138254}
.practice-name{margin-top:4rpx;font-size:22rpx;line-height:1.4;color:#7c8aa0}
.practice-arrow{display:flex;align-items:center;justify-content:center;flex-shrink:0;width:50rpx;height:50rpx;border-radius:50%;background:rgba(255,255,255,.85);color:#1688f8;font-size:42rpx;line-height:1}
.print-section,.recent-section{margin-top:32rpx}
.print-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx}
.page-wrap .print-tile{display:flex;flex-direction:column;align-items:center;justify-content:center;width:100%;min-width:0;padding:30rpx 8rpx 33rpx;border-radius:28rpx;box-sizing:border-box;text-align:center}
.page-wrap .print-tile.print-chinese{background:#fff0e5;color:#c83f39}
.page-wrap .print-tile.print-math{background:#e6f2ff;color:#2262cc}
.page-wrap .print-tile.print-english{background:#e5f7ec;color:#138254}
.print-chinese .print-name{color:#c83f39}
.print-math .print-name{color:#2262cc}
.print-english .print-name{color:#138254}
.print-icon-wrap{display:flex;align-items:center;justify-content:center;width:98rpx;height:98rpx;margin-bottom:15rpx}
.print-icon{display:block;width:84rpx;height:84rpx}
.print-name{font-size:27rpx;font-weight:700;line-height:1.4}
.print-desc{margin-top:5rpx;font-size:20rpx;line-height:1.4;color:#7c8aa0;white-space:nowrap}
.page-wrap .history-link{display:inline-flex;align-items:center;justify-content:center;width:auto;height:72rpx;padding:0 26rpx;border-radius:36rpx;background:transparent;font-size:28rpx;font-weight:500;line-height:1;color:#268bff;letter-spacing:1rpx}
.history-arrow{flex-shrink:0;width:14rpx;height:14rpx;margin-left:10rpx;border-top:2rpx solid currentColor;border-right:2rpx solid currentColor;transform:rotate(45deg)}
.recent-section .section-head{margin-bottom:10rpx}
.recent-list{padding:0 22rpx;border-radius:28rpx;background:#fff}
.page-wrap .recent-item{display:flex;align-items:center;width:100%;gap:18rpx;padding:22rpx 0;border-bottom:1rpx solid #eff3f8;box-sizing:border-box}
.recent-item:last-child{border-bottom:0}
.recent-icon{width:60rpx;height:60rpx;flex-shrink:0}
.recent-info{flex:1;min-width:0}
.recent-name{font-size:26rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.recent-meta{font-size:22rpx;color:#64748b;margin-top:8rpx}
.recent-arrow{color:#7892ad;font-size:36rpx;flex-shrink:0}
.row-pressed{opacity:.7}
.tile-pressed{opacity:.75}
