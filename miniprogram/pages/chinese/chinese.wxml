<view class="page-wrap">
  <view class="mode-grid">
    <view class="mode-card {{modeIndex === 0 ? 'on' : ''}}" data-index="0" bindtap="onModeTap">
      <image class="mode-icon" src="/assets/chinese/mode-copy.png" mode="aspectFit" />
      <view class="mode-name">练字帖</view>
      <view class="mode-desc">描红临摹<br />规范书写</view>
    </view>
    <view class="mode-card {{modeIndex === 1 ? 'on' : ''}}" data-index="1" bindtap="onModeTap">
      <image class="mode-icon" src="/assets/chinese/mode-dictation.png" mode="aspectFit" />
      <view class="mode-name">听写卷</view>
      <view class="mode-desc">看拼音<br />默写生字</view>
    </view>
    <view class="mode-card {{modeIndex === 2 ? 'on' : ''}}" data-index="2" bindtap="onModeTap">
      <image class="mode-icon" src="/assets/chinese/mode-card.png" mode="aspectFit" />
      <view class="mode-name">生字卡片</view>
      <view class="mode-desc">笔顺组词<br />识字复习</view>
    </view>
  </view>

  <view class="mode-hint">
    <view class="hint-mark">!</view>
    <text wx:if="{{modeIndex === 0}}">生成范字、描红和空白练习格，适合日常书写训练</text>
    <text wx:elif="{{modeIndex === 1}}">自动显示拼音，整行留白，适合家长报词听写</text>
    <text wx:else>展示拼音、笔顺、部首和组词，适合识字复习</text>
  </view>

  <view class="section-card content-card">
    <view class="section-head">
      <view class="section-title"><view class="section-dot"></view><text>{{importSummary || chars ? '已选内容' : '选择练习内容'}}</text></view>
      <text class="section-action" wx:if="{{importSummary}}" bindtap="openModal">修改</text>
    </view>

    <view class="book-row" bindtap="openModal">
      <view class="book-symbol">书</view>
      <view class="book-info">
        <view class="book-name">{{importSummary || '选择教材与课文'}}</view>
        <view class="book-sub" wx:if="{{importSummary}}">已导入 {{chars.length}} 个生字 · 一次选择一课</view>
        <view class="book-sub" wx:else>{{bookNames.length || 12}} 册教材 · 按识字/拼音/课文分组</view>
      </view>
      <view class="chev">›</view>
    </view>

    <view class="manual-toggle" bindtap="toggleManual">
      <text>{{manualOpen ? '收起手动输入' : '手动输入生字或修正内容'}}</text>
      <text class="manual-state">{{manualOpen ? '收起' : '展开'}}</text>
    </view>

    <view class="manual-panel" wx:if="{{manualOpen}}">
      <view class="field-label-row"><text>生字（拼音自动标注）</text><text>{{chars.length}}/{{modeLimit}}</text></view>
      <textarea class="textarea" placeholder="输入要练的汉字，如：大小日月" value="{{chars}}" bindinput="onCharsInput" maxlength="{{modeLimit}}" fixed />
      <view class="field-help">每个字独占一行，按 A4 自动排版</view>
      <input class="text-input" placeholder="拼音修正（可选），按生字顺序用空格分隔" value="{{pinyinOverride}}" bindinput="onPinyinInput" />
      <view class="field-help">拼音数量与生字不一致时自动忽略</view>
      <input wx:if="{{!importSummary}}" class="text-input title-input" placeholder="字帖标题（可选）" value="{{title}}" bindinput="onTitleInput" />
    </view>
  </view>

  <view class="section-card preview-section">
    <view class="section-head">
      <view class="section-title"><view class="section-dot"></view><text>字帖效果预览</text></view>
      <text class="preview-note">{{previewIsSample ? '示例' : '当前内容'}}</text>
    </view>
    <view wx:if="{{modeIndex === 2}}" class="character-card-preview {{paperIndex === 1 ? 'simple' : ''}}">
      <view class="card-preview-top">
        <view class="card-preview-pinyin">{{cardMeta.pinyin || '自动注音'}}</view>
        <view class="card-preview-tag">生字卡片</view>
      </view>
      <view class="card-preview-body">
        <view class="card-main-grid">
          <view class="cell-v"></view><view class="cell-h"></view>
          <text class="card-main-char {{fontIndex === 1 ? 'xing' : ''}}">{{cardMeta.char}}</text>
        </view>
        <view class="card-preview-info">
          <view class="card-meta-row">
            <text>{{cardMeta.strokeCount ? cardMeta.strokeCount + ' 画' : '笔画自动生成'}}</text>
            <text>{{cardMeta.radical ? cardMeta.radical + ' 部' : '部首自动识别'}}</text>
            <text>{{cardMeta.structure || '结构自动识别'}}</text>
          </view>
          <view class="card-words"><text class="card-words-label">组词</text><text>{{cardMeta.wordsText || '生成时自动匹配'}}</text></view>
          <view class="card-practice-row">
            <view wx:for="{{cardPreviewCells}}" wx:key="*this" class="card-practice-cell">
              <text class="{{index === 0 ? 'demo' : index <= traceCount ? 'trace' : ''}}">{{index === 0 || index <= traceCount ? cardMeta.char : ''}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    <view wx:else class="practice-preview {{paperIndex === 1 ? 'simple' : ''}}">
      <view class="preview-pinyin" wx:if="{{showPinyin}}">{{previewPinyin || '自动注音'}}</view>
      <view class="preview-cells">
        <view wx:for="{{previewCells}}" wx:key="key" class="practice-cell grid-{{gridIndex}}">
          <view class="cell-v" wx:if="{{gridIndex !== 2}}"></view><view class="cell-h" wx:if="{{gridIndex !== 2}}"></view>
          <view class="cell-d d1" wx:if="{{gridIndex === 1}}"></view><view class="cell-d d2" wx:if="{{gridIndex === 1}}"></view>
          <text class="preview-char {{item.style}} {{fontIndex === 1 ? 'xing' : ''}}">{{item.char}}</text>
        </view>
      </view>
      <view class="preview-legend" wx:if="{{modeIndex !== 1}}"><text>范字</text><text>描红</text><text>自主练习</text></view>
      <view class="dictation-label" wx:else>看拼音，在空白格中默写生字</view>
    </view>
  </view>

  <view class="section-card style-card" bindtap="openSettings">
    <view class="style-copy">
      <view class="style-title">字帖样式</view>
      <view class="style-summary">{{styleSummary}}</view>
    </view>
    <view class="style-action">更多设置 ›</view>
  </view>

  <button class="btn-primary generate" loading="{{submitting}}" disabled="{{!chars || quotaRemaining === 0}}" bindtap="submit">
    {{modeIndex === 1 ? '生成听写卷' : modeIndex === 2 ? '生成生字卡片' : '生成字帖'}}
  </button>
  <view class="quota-tip" wx:if="{{quotaRemaining !== null}}">今日还可生成 {{quotaRemaining}} 份 · 普通用户每天 3 份</view>

  <view class="share-reward-card">
    <view class="share-reward-copy">
      <view class="share-reward-title">分享得生成次数</view>
      <view class="share-reward-desc">好友打开 +1 份 · 微信群打开 +5 份</view>
      <view class="share-reward-note">同一好友或同一群每天奖励一次{{shareBonus ? ' · 今日已奖励 ' + shareBonus + ' 份' : ''}}</view>
    </view>
    <button class="share-reward-btn" open-type="share">去分享</button>
  </view>

  <view class="mascot-guide">
    <view class="guide-deco deco-one"></view><view class="guide-deco deco-two"></view>
    <image class="guide-image" src="/assets/chinese/mascot-writing.png" mode="aspectFit" />
    <view class="guide-copy"><text class="guide-kicker">小墨陪你练</text><text class="guide-message">每天一页，进步一点点！</text></view>
  </view>
</view>

<view class="tb-mask" wx:if="{{modalOpen}}" bindtap="closeModal" catchtouchmove="noop">
  <view class="tb-panel" catchtap="noop">
    <view class="tb-head">
      <view><view class="tb-title">选择教材与课文</view><view class="tb-head-sub">一次选择一课，选择新课会替换原选择</view></view>
      <view class="tb-close" bindtap="closeModal">×</view>
    </view>

    <view class="tb-toptabs">
      <view class="tb-toptab {{modalTabIndex === 0 ? 'on' : ''}}" data-index="0" bindtap="onModalTabTap">课文生字</view>
      <view class="tb-toptab {{modalTabIndex === 1 ? 'on' : ''}}" data-index="1" bindtap="onModalTabTap">古诗词</view>
    </view>

    <scroll-view scroll-y class="tb-body">
      <block wx:if="{{modalTabIndex === 0}}">
        <view class="tb-block-label">教材版本</view>
        <view class="tb-books-grid">
          <view wx:for="{{bookNames}}" wx:key="index" class="tb-book {{modalBookIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onModalBookTap">
            <text class="tb-book-name">{{bookShorts[index]}}</text><text class="tb-book-count">{{bookCounts[index]}}</text>
            <text wx:if="{{bookLegacy[index]}}" class="tb-book-legacy">旧版</text>
          </view>
        </view>
        <view wx:if="{{!bookNames.length}}" class="tb-loading">教材加载中…</view>
        <view class="tb-legacy-tip" wx:if="{{modalBookIndex >= 0 && bookLegacy[modalBookIndex]}}">该册为旧版课目，生字以孩子实际课本为准</view>
        <view class="tb-current" wx:if="{{modalBookIndex >= 0}}">{{bookNames[modalBookIndex]}}</view>
        <view class="tb-tabs" wx:if="{{modalSections.length}}">
          <view wx:for="{{modalSections}}" wx:key="label" class="tb-tab {{modalSectionIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onModalSectionTap">{{item.label}}</view>
        </view>
        <view class="tb-block-label" wx:if="{{modalSections.length}}">选择课文（单选）</view>
        <view wx:if="{{modalBookLoading}}" class="tb-loading">课文加载中…</view>
        <view wx:elif="{{modalSections.length}}" class="tb-lesson-list">
          <view wx:for="{{modalSections[modalSectionIndex].lessons}}" wx:key="index" class="tb-lesson {{item.selected ? 'on' : ''}}" data-index="{{item.index}}" bindtap="onModalLessonClick">
            <view class="lesson-check">{{item.selected ? '✓' : ''}}</view><text class="lesson-title">{{item.title}}</text><text class="lesson-count">{{item.charCount}} 字</text>
          </view>
        </view>
        <view wx:else class="tb-loading">选择教材后显示课文</view>
      </block>

      <block wx:else>
        <view class="tb-block-label">选择年级</view>
        <scroll-view scroll-x class="tb-tabs-scroll" enhanced show-scrollbar="{{false}}"><view class="tb-gradebar">
          <view wx:for="{{poemGrades}}" wx:key="*this" class="tb-grade {{poemGradeIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onPoemGradeTap">{{item}}</view>
        </view></scroll-view>
        <view class="tb-block-label">选择诗词（单选）</view>
        <view wx:for="{{poemsOfGrade}}" wx:key="id" class="tb-poem {{poemSelectedId === item.id ? 'on' : ''}}" data-id="{{item.id}}" bindtap="onPoemTap">
          <view class="tb-poem-head"><text class="tb-poem-title">{{item.title}}</text><text class="tb-poem-author">{{item.author}}</text></view><text class="tb-poem-text">{{item.text}}</text>
        </view>
        <view wx:if="{{!poemsOfGrade.length}}" class="tb-loading">诗词加载中…</view>
      </block>
      <view class="tb-body-pad"></view>
    </scroll-view>

    <view class="tb-footer">
      <view class="tb-stat" wx:if="{{modalTabIndex === 0}}">
        <text wx:if="{{selectedCount}}">{{selectedLessonTitle}}</text><text wx:else>尚未选择课文</text>
        <text class="tb-limit">{{selectedCount ? selectedCharCount + ' 个生字 · 单课导入' : '一次只能选择一课'}}</text>
      </view>
      <view class="tb-stat" wx:else><text>选一首诗 · 整首生字练习</text><text class="tb-limit">标点自动去除</text></view>
      <button class="tb-import" bindtap="confirmImport" disabled="{{modalTabIndex === 0 ? selectedCount === 0 : !poemSelectedId}}">确认导入</button>
    </view>
  </view>
</view>
