<view class="en-page">
  <!-- 英语打印首页 -->
  <block wx:if="{{stage === 'home'}}">
    <view class="hero">
      <view class="hero-copy">
        <view class="hero-title">同步教材 · 英语打印</view>
        <view class="hero-sub">单词 · 句子 · 连词成句</view>
        <view class="hero-note">Practice makes progress!</view>
      </view>
      <image class="hero-image" src="/assets/english/english-hero-xiaomo.png" mode="aspectFit" />
    </view>

    <view class="section-card" wx:if="{{currentBook}}" bindtap="chooseExercise" data-type="word">
      <view class="section-head"><text class="section-title">当前教材</text><text class="section-action">更换 ›</text></view>
      <view class="current-book">
        <image class="book-cover" src="/assets/english/english-textbook.png" mode="aspectFit" />
        <view class="book-copy"><view class="book-name">{{currentBook.name}}</view><view class="book-meta">{{currentUnit ? currentUnit.displayTitle : '选择单元后开始'}}</view></view>
      </view>
    </view>

    <view class="block-title">选择打印内容</view>
    <view class="exercise-grid">
      <view class="exercise-card word" data-type="word" bindtap="chooseExercise"><view class="exercise-icon">Aa</view><view class="exercise-name">单词练习</view><view class="exercise-desc">英文描红 · 默写</view></view>
      <view class="exercise-card sentence" data-type="sentence" bindtap="chooseExercise"><image class="exercise-image" src="/assets/english/mode-sentence.png" mode="aspectFit" /><view class="exercise-name">句子练习</view><view class="exercise-desc">句子描红 · 听写</view></view>
      <view class="exercise-card unscramble" data-type="unscramble" bindtap="chooseExercise"><image class="exercise-image wide" src="/assets/english/mode-unscramble.png" mode="aspectFit" /><view class="exercise-name">连词成句</view><view class="exercise-desc">单词乱序 · 排序</view></view>
      <view class="exercise-card more" data-type="more" bindtap="chooseExercise"><view class="exercise-icon">•••</view><view class="exercise-name">更多功能</view><view class="exercise-desc">字母书写 · 单词包</view></view>
    </view>

    <view class="section-card history-link" bindtap="goHistory"><view class="history-icon">◷</view><view class="book-copy"><view class="book-name">打印记录</view><view class="book-meta">查看已生成的英语资料</view></view><text class="section-action">›</text></view>
  </block>

  <!-- 教材/单元单选 -->
  <block wx:elif="{{stage === 'select'}}">
    <block wx:if="{{sourceKind === 'textbook'}}">
      <view class="filter-block"><view class="filter-title">教材版本</view><view class="filter-row"><view wx:for="{{versions}}" wx:key="id" class="filter-chip {{versionIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onVersionTap">{{item.name}}</view></view></view>
      <view class="filter-block"><view class="filter-title">选择年级</view><view class="filter-row"><view wx:for="{{grades}}" wx:key="*this" class="filter-chip {{gradeIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onGradeTap">{{item}}年级</view></view></view>
      <view class="filter-block"><view class="filter-title">选择册次</view><view class="filter-row two"><view wx:for="{{semesters}}" wx:key="id" class="filter-chip {{semesterIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onSemesterTap">{{item.name}}</view></view></view>
    </block>

    <view class="selected-course" wx:if="{{currentBook}}">
      <image class="selected-course-cover" src="/assets/english/english-textbook.png" mode="aspectFit" />
      <view class="selected-course-copy"><view class="selected-course-label">当前教材</view><view class="selected-course-name">{{currentBook.name}}</view><view class="selected-course-unit" wx:if="{{currentUnit}}">已选 · {{currentUnit.displayTitle}}</view></view>
      <view class="selected-course-check">✓</view>
    </view>

    <view class="filter-block" wx:else>
      <view class="filter-title">选择主题词包</view>
      <view class="filter-row"><view wx:for="{{packBooks}}" wx:key="id" class="filter-chip {{currentBook.id === item.id ? 'on' : ''}}" data-index="{{index}}" bindtap="onPackTap">{{item.name}}</view></view>
    </view>

    <view class="coverage-tip" wx:if="{{coverageText}}">{{coverageText}}</view>
    <view class="filter-title unit-heading">选择单元（单选）</view>
    <view wx:if="{{loading}}" class="empty-state">单元加载中…</view>
    <view wx:elif="{{!currentBook}}" class="empty-state">该册内容暂未开放</view>
    <view wx:else class="unit-list">
      <view wx:for="{{units}}" wx:key="unitNo" class="unit-row {{unitIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onUnitTap">
        <view class="radio">{{unitIndex === index ? '✓' : ''}}</view>
        <view class="unit-copy"><view class="unit-title">{{item.displayTitle}}</view><view class="unit-meta">{{item.wordCount}}个单词 · {{item.sentenceCount}}个重点句</view></view>
        <text class="unit-selected" wx:if="{{unitIndex === index}}">已选</text><text class="unit-arrow" wx:else>›</text>
      </view>
    </view>
    <view class="bottom-space"></view>
    <view class="sticky-bar"><button class="btn-primary" disabled="{{!currentUnit}}" bindtap="confirmUnit">确认选择</button></view>
  </block>

  <!-- 单词/句子/连词成句共用配置 -->
  <block wx:elif="{{stage === 'config'}}">
    <view class="section-card current-card" wx:if="{{exerciseType !== 'alphabet'}}">
      <view class="current-book"><image class="book-cover" src="/assets/english/english-textbook.png" mode="aspectFit" /><view class="book-copy"><view class="book-name">{{currentUnit.displayTitle}}</view><view class="book-meta">{{currentBook.name}} · {{currentUnit.wordCount}}词 / {{currentUnit.sentenceCount}}句</view></view><button class="mini-btn" bindtap="changeUnit">更换单元</button></view>
    </view>

    <view class="section-card" wx:if="{{practiceModes.length}}">
      <view class="section-title">练习方式</view>
      <view class="practice-list">
        <view wx:for="{{practiceModes}}" wx:key="id" class="practice-row {{practiceIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onPracticeTap">
          <view class="radio">{{practiceIndex === index ? '●' : ''}}</view><view class="practice-copy"><view class="practice-name">{{item.name}}<text wx:if="{{item.recommended}}" class="recommended">推荐</text></view><view class="practice-desc">{{item.desc}}</view></view>
        </view>
      </view>
    </view>

    <view class="section-card option-card" wx:if="{{exerciseType !== 'alphabet' && (exerciseType === 'unscramble' || practiceIndex === 0)}}">
      <view><view class="option-title">{{exerciseType === 'word' ? '显示中文释义' : '显示中文翻译'}}</view><view class="option-desc">在题目旁辅助理解内容</view></view>
      <switch checked="{{showTranslation}}" color="#3b82f6" bindchange="onTranslationToggle" />
    </view>
    <view class="section-card option-card" wx:if="{{exerciseType === 'unscramble'}}"><view><view class="option-title">附答案页</view><view class="option-desc">方便家长打印后核对</view></view><switch checked="{{answerSheet}}" color="#3b82f6" bindchange="onAnswerToggle" /></view>

    <view class="section-card">
      <view class="section-head"><text class="section-title">效果预览</text><text class="preview-label">当前内容</text></view>
      <view class="alphabet-preview font-{{fontIndex}}" wx:if="{{exerciseType === 'alphabet'}}">Aa Bb Cc Dd Ee Ff</view>
      <view class="preview-box" wx:elif="{{preview}}">
        <view class="preview-translation" wx:if="{{showTranslation && preview.secondary}}">{{preview.secondary}}</view>
        <view class="token-preview" wx:if="{{exerciseType === 'unscramble'}}"><text wx:for="{{preview.tokens}}" wx:key="index">{{item}}</text><text class="token-punctuation" wx:if="{{preview.punctuation}}">{{preview.punctuation}}</text></view>
        <view class="four-lines preview-copy-line" wx:elif="{{exerciseType === 'word' && practiceIndex === 0}}"><view></view><view></view><view></view><view></view><view class="preview-copy-samples font-{{fontIndex}}"><text wx:for="{{preview.copySamples}}" wx:key="index" class="{{item.style}}">{{preview.answer}}</text></view></view>
        <block wx:else><view class="preview-word font-{{fontIndex}}">{{preview.primary}}</view><view class="four-lines"><view></view><view></view><view></view><view></view><text class="trace-word font-{{fontIndex}}">{{practiceIndex === 0 ? preview.answer : ''}}</text></view></block>
      </view>
    </view>

    <view class="section-card style-link" bindtap="openSettings"><view><view class="section-title">字帖样式</view><view class="style-summary">{{styleSummary}}</view></view><text class="section-action">更多设置 ›</text></view>

    <button class="btn-primary generate" loading="{{submitting}}" disabled="{{quotaRemaining === 0}}" bindtap="submit">预览生成</button>
    <view class="quota-tip" wx:if="{{quotaRemaining !== null}}">今日还可生成 {{quotaRemaining}} 份 · 普通用户每天 3 份</view>
    <view class="share-card"><view><view class="share-title">分享得生成次数</view><view class="share-desc">好友打开 +1 份 · 微信群打开 +5 份</view></view><button open-type="share">去分享</button></view>
  </block>

  <!-- 英语样式设置：系统返回键回到配置页 -->
  <block wx:elif="{{stage === 'settings'}}">
    <view class="settings-intro"><view class="settings-title">按孩子当前阶段调整</view><view class="settings-sub">默认设置已适合日常练习</view></view>
    <view class="section-card"><view class="section-title">书写字体</view><view class="choice-row three font-choices"><view wx:for="{{fontNames}}" wx:key="*this" class="choice font-choice {{fontIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onFontTap"><text class="font-sample font-{{index}}">Aa</text><text>{{item}}</text><text wx:if="{{index === 0}}" class="choice-note">推荐</text></view></view></view>
    <view class="section-card"><view class="section-title">纸张样式</view><view class="choice-row"><view class="choice {{paperIndex === 0 ? 'on' : ''}}" data-index="0" bindtap="onPaperTap">四线三格<text class="choice-note">绿线 · 红描红</text></view><view class="choice {{paperIndex === 1 ? 'on' : ''}}" data-index="1" bindtap="onPaperTap">素雅<text class="choice-note">灰线 · 浅描红</text></view></view></view>
    <view class="section-card" wx:if="{{exerciseType === 'alphabet'}}"><view class="section-title">字母大小写</view><view class="choice-row three"><view wx:for="{{caseNames}}" wx:key="*this" class="choice {{caseIndex === index ? 'on' : ''}}" data-index="{{index}}" bindtap="onCaseTap">{{item}}</view></view></view>
    <view class="section-card" wx:if="{{exerciseType !== 'unscramble' && exerciseType !== 'word' && practiceIndex === 0}}"><view class="range-head"><text>描红次数</text><text class="range-value">{{traceCount}} 次</text></view><slider min="0" max="4" step="1" value="{{traceCount}}" bindchange="onTraceChange" activeColor="#3b82f6" /><view class="range-head"><text>每题书写行数</text><text class="range-value">{{blankCount}} 行</text></view><slider min="2" max="4" step="1" value="{{blankCount}}" bindchange="onBlankChange" activeColor="#3b82f6" /></view>
    <view class="section-card settings-preview-card">
      <view class="section-head"><text class="section-title">样式效果</text><text class="preview-label">实时预览</text></view>
      <view class="alphabet-preview font-{{fontIndex}} paper-{{paperIndex}}" wx:if="{{exerciseType === 'alphabet'}}">Aa Bb Cc Dd Ee Ff</view>
      <view class="preview-box paper-{{paperIndex}}" wx:elif="{{preview}}">
        <view class="preview-translation" wx:if="{{showTranslation && preview.secondary}}">{{preview.secondary}}</view>
        <view class="token-preview" wx:if="{{exerciseType === 'unscramble'}}"><text wx:for="{{preview.tokens}}" wx:key="index">{{item}}</text><text class="token-punctuation" wx:if="{{preview.punctuation}}">{{preview.punctuation}}</text></view>
        <view class="four-lines preview-copy-line" wx:elif="{{exerciseType === 'word' && practiceIndex === 0}}"><view></view><view></view><view></view><view></view><view class="preview-copy-samples font-{{fontIndex}}"><text wx:for="{{preview.copySamples}}" wx:key="index" class="{{item.style}}">{{preview.answer}}</text></view></view>
        <block wx:else><view class="preview-word font-{{fontIndex}}">{{preview.primary}}</view><view class="four-lines"><view></view><view></view><view></view><view></view><text class="trace-word font-{{fontIndex}}">{{practiceIndex === 0 ? preview.answer : ''}}</text></view></block>
        <view class="preview-count-note" wx:if="{{exerciseType === 'word' && practiceIndex === 0}}">固定描红版式 · 每词一行</view>
        <view class="preview-count-note" wx:elif="{{practiceIndex === 1}}">听写固定版式 · 每题一行四线三格</view>
        <view class="preview-count-note" wx:elif="{{exerciseType !== 'unscramble'}}">描红 {{traceCount}} 次 · 每题 {{blankCount}} 行</view>
      </view>
    </view>
    <view class="bottom-space"></view><view class="sticky-bar"><button class="btn-primary" bindtap="saveSettings">保存设置</button></view>
  </block>

  <!-- 更多功能只放已有能力 -->
  <block wx:else>
    <view class="more-list">
      <view class="more-row" bindtap="startAlphabet"><image class="more-image" src="/assets/english/alphabet-writing.png" mode="aspectFit" /><view class="book-copy"><view class="book-name">字母书写</view><view class="book-meta">26个字母、大小写描红</view></view><text>›</text></view>
      <view class="more-row" bindtap="startThemes"><image class="more-image" src="/assets/english/theme-words.png" mode="aspectFit" /><view class="book-copy"><view class="book-name">主题词包</view><view class="book-meta">少儿高频词、核心词汇</view></view><text>›</text></view>
    </view>
  </block>
</view>
