<view class="page-wrap">
  <view class="me-card">
    <view class="avatar"><image class="avatar-img" src="/assets/mascot/wave.png" mode="aspectFit" /></view>
    <view class="me-info">
      <view class="me-name">我的学习空间</view>
      <view class="me-sub" wx:if="{{vip}}">会员 · 有效期至 {{vipUntil}}</view>
      <view class="me-sub" wx:elif="{{quotaRemaining !== null}}">今日剩余生成 {{quotaRemaining}} 份</view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item grade-row">
      <text>当前年级</text>
      <view class="grade-seg">
        <view wx:for="{{grades}}" wx:key="*this" class="g-item {{grade === item ? 'on' : ''}}" data-g="{{item}}" bindtap="onGradeTap">{{item}}</view>
      </view>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goHistory"><text>打印历史</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goRadicals"><text>偏旁部首练习</text><text class="arrow">›</text></view>
    <view class="menu-item" bindtap="goMath"><text>口算题卡</text><text class="arrow">›</text></view>
  </view>

  <view class="menu-card">
    <button class="menu-item contact" open-type="contact"><text>意见反馈</text></button>
    <view class="menu-item" bindtap="goAbout"><text>关于与隐私</text><text class="arrow">›</text></view>
  </view>

  <view class="foot-tip">教材设置与孩子档案将在下一阶段完善</view>
</view>
