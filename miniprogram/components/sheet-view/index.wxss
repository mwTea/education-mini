.sheet {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(176, 101, 58, 0.08);
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
  color: #3b2f2a;
}

.bank {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  border: 2rpx dashed #5b9e7d;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  margin-bottom: 24rpx;
}

.bank-label {
  color: #e2544e;
  font-size: 24rpx;
  flex-shrink: 0;
}

.bank-words {
  color: #6b5f57;
  font-size: 24rpx;
  word-break: break-all;
}

.sheet-page {
  margin-bottom: 40rpx;
}

.page-no {
  text-align: right;
  color: #b3a89d;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* ---- 语文格 ---- */
.crow {
  display: flex;
}

.cwrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex-shrink: 0;
}

.pinyin {
  text-align: center;
  color: #9a7b6b;
  overflow: hidden;
}

.cell {
  position: relative;
  border: 2rpx solid #5b9e7d;
  box-sizing: border-box;
  flex-shrink: 0;
}

.gl-v {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  border-left: 2rpx dashed #a8cbb6;
}

.gl-h {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  border-top: 2rpx dashed #a8cbb6;
}

.gl-d {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 141%;
  height: 0;
  border-top: 2rpx dashed #a8cbb6;
  transform: translate(-50%, -50%) rotate(45deg);
}

.gl-d.d2 {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.char {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  font-family: 'CBKai', 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
}

/* 行楷字体栈（iOS 有华文行楷，Android 回落楷体） */
.char.xk {
  font-family: 'CBXing', 'STXingkai', 'Xingkai SC', 'Kaiti SC', serif;
}

/* ---- 英语四线三格 ---- */
.erow {
  position: relative;
  width: 100%;
}

.eline {
  position: absolute;
  left: 0;
  right: 0;
  border-top: 2rpx solid #5b9e7d;
}

.eline.l1 {
  top: 0;
}

.eline.l2 {
  top: 33.33%;
  border-top: 2rpx dashed #a8cbb6;
}

.eline.l3 {
  top: 66.66%;
}

.eline.l4 {
  top: 100%;
}

.etext {
  position: absolute;
  left: 4rpx;
  top: 0;
  height: 66.66%;
  display: flex;
  align-items: flex-end;
  line-height: 1;
  white-space: nowrap;
  font-family: 'CBKai', 'Helvetica Neue', Arial, sans-serif;
}

.etext.blank {
  color: transparent;
}

.ecell {
  display: inline-block;
  text-align: center;
  flex-shrink: 0;
}

/* ---- 生字卡片（与 PDF 同构：红框卡 / 顶栏拼音格+笔顺条 / 左栏范字标签 / 右栏描红+组词） ---- */
.cardbox {
  border: 4rpx solid #d95f52;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 28rpx;
  background: #ffffff;
}

/* 顶栏 */
.cb-top {
  display: flex;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.cb-pybox {
  width: 132rpx;
  flex-shrink: 0;
  border: 2rpx solid #d95f52;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx 0;
}

.cb-py {
  font-size: 34rpx;
  font-weight: 600;
  color: #3a2e25;
}

.cb-strokes {
  flex: 1;
  min-width: 0;
  border: 2rpx solid #d95f52;
  border-radius: 8rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 笔顺图片（canvas 离屏绘制导出，image 同层渲染随页面滚动） */
.stroke-img {
  width: 100%;
  height: 96rpx;
  display: block;
}

/* 隐藏工作画板：移出可视区，仅用于绘制导出 */
.stroke-work {
  position: absolute;
  left: -2000px;
  top: 0;
  width: 320px;
  height: 48px;
}

.cb-strokes-empty {
  font-size: 20rpx;
  color: #c9b8a3;
}

/* 主体：左栏 + 右栏 */
.cb-body {
  display: flex;
  gap: 12rpx;
}

.cb-left {
  width: 184rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cb-demo {
  width: 184rpx;
  height: 184rpx;
  position: relative;
}

.cb-labels {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cb-label {
  font-size: 20rpx;
  line-height: 1.5;
  color: #3a2e25;
  border: 2rpx solid #e8c9b0;
  border-radius: 6rpx;
  text-align: center;
  background: #fff7ec;
}

.cb-right {
  flex: 1;
  min-width: 0;
}

.cb-words {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #6b5f51;
  margin: 4rpx 0 8rpx;
}

.cardbox .crow {
  margin-bottom: 8rpx;
  justify-content: flex-start;
}


/* ---- 英语默写：提示行与方格 ---- */
.hrow {
  font-size: 26rpx;
  font-weight: 500;
  color: #3a2e25;
  padding: 8rpx 4rpx 14rpx;
}

.fgrow {
  display: flex;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.fcell {
  border: 2rpx solid #5b9e7d;
  border-radius: 6rpx;
  box-sizing: border-box;
}

/* ---- 数学：口算三列 / 竖式 / 应用题 / 答案 ---- */
.mgrid { display: flex; flex-wrap: wrap; }
.msection { font-size: 28rpx; font-weight: 600; color: #222; margin: 24rpx 0 10rpx; }
.mitem.cols-4 { font-size: 22rpx; padding: 14rpx 3rpx; }
.mitem.cols-3 { font-size: 24rpx; }
.clock-grid { display: flex; }
.clock-item { width: 25%; box-sizing: border-box; padding: 8rpx 4rpx 24rpx; font-size: 20rpx; color: #222; }
.clock-image { display: block; width: 100%; height: 150rpx; }
.mword { text-align: left; }
.mword .wq { min-height: 210rpx; box-sizing: border-box; }
.mitem { width: 33.33%; box-sizing: border-box; padding: 14rpx 8rpx; font-size: 30rpx; color: #2f2a26; }
.vgrid { display: flex; flex-wrap: wrap; margin-top: 10rpx; }
.vbox { width: 50%; box-sizing: border-box; height: 220rpx; padding: 16rpx 20rpx; }
.vnum { font-size: 40rpx; color: #2f2a26; margin-left: 40rpx; line-height: 1.7; }
.vline { border-top: 3rpx solid #2f2a26; width: 140rpx; margin: 6rpx 0 0 40rpx; }
.mword .wq { font-size: 28rpx; color: #2f2a26; line-height: 1.9; padding: 16rpx 0; border-bottom: 2rpx dashed #e5dccd; margin-bottom: 20rpx; }
.m-answers-head { text-align: center; font-size: 30rpx; font-weight: 600; color: #2f2a26; margin: 24rpx 0 12rpx; }
.aitem { width: 25%; box-sizing: border-box; padding: 10rpx 6rpx; font-size: 26rpx; color: #3a2e25; }
