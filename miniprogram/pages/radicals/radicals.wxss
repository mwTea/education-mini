/* 偏旁部首练习：暖橙纸面风格 */
.page-wrap {
  min-height: 100vh;
  background: #f4f1e9;
  padding: 24rpx 28rpx 60rpx;
  box-sizing: border-box;
}

.tip-card {
  background: linear-gradient(135deg, var(--c-warm-light), var(--c-warm));
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}

.tip-title { color: #fff; font-size: 34rpx; font-weight: 600; }
.tip-sub { color: var(--c-warm-soft); font-size: 22rpx; margin-top: 8rpx; }

.search-row { margin-bottom: 24rpx; }

.search-input {
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 40rpx;
  padding: 16rpx 30rpx;
  font-size: 26rpx;
  color: var(--c-text);
}

.state {
  text-align: center;
  color: var(--c-text-faint);
  padding: 80rpx 0;
}
.state.error { color: var(--c-error); white-space: pre-line; line-height: 1.8; }

.radical-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.radical-card {
  width: calc((100% - 40rpx) / 3);
  background: #fff;
  border: 2rpx solid var(--c-line);
  border-radius: 20rpx;
  padding: 22rpx 12rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

.r-grid {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  border: 2rpx solid #5b9e7d;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.rg-v, .rg-h { position: absolute; }
.rg-v { left: 50%; top: 6rpx; bottom: 6rpx; border-left: 2rpx dashed #a8cbb6; }
.rg-h { top: 50%; left: 6rpx; right: 6rpx; border-top: 2rpx dashed #a8cbb6; }

.r-char {
  font-size: 64rpx;
  color: var(--c-text);
  font-family: 'CBKai', 'Kaiti SC', 'STKaiti', 'KaiTi', serif;
  line-height: 1;
}

.r-name {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--c-text);
  font-weight: 600;
}

.r-ex {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: var(--c-text-faint);
  min-height: 28rpx;
}

.pdf-caption {
  text-align: center;
  color: var(--c-text-faint);
  font-size: 22rpx;
  padding: 30rpx 0 10rpx;
}

.overview-card {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff; border: 2rpx solid var(--c-line); border-radius: 20rpx;
  padding: 22rpx 26rpx; margin-bottom: 24rpx;
}
.ov-grid { position: relative; width: 88rpx; height: 88rpx; border: 2rpx solid #5b9e7d; border-radius: 8rpx;
  display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; }
.ov-v { position: absolute; left: 50%; top: 6rpx; bottom: 6rpx; border-left: 2rpx dashed #a8cbb6; }
.ov-h { position: absolute; top: 50%; left: 6rpx; right: 6rpx; border-top: 2rpx dashed #a8cbb6; }
.ov-char { font-size: 56rpx; color: var(--c-text); font-family: 'CBKai','Kaiti SC','STKaiti','KaiTi',serif; }
.ov-info { flex: 1; }
.ov-title { font-size: 28rpx; font-weight: 600; color: var(--c-text); }
.ov-sub { font-size: 22rpx; color: var(--c-text-faint); margin-top: 6rpx; }
.ov-arrow { color: var(--c-text-faint); font-size: 36rpx; }
.ad-slot { height: 120rpx; }
