/* 首页：暖橙 Hero + 小墨 + 三科渐变图标卡。颜色统一走 app.wxss 令牌。 */
.page-wrap{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box}

.brand-row{display:flex;align-items:center;justify-content:space-between}
.brand{font-size:42rpx;font-weight:750;color:#12305e;letter-spacing:1rpx}
.slogan{font-size:22rpx;color:var(--c-text-sub);margin-top:4rpx}
.brand-mark{width:68rpx;height:68rpx;border-radius:20rpx;background:linear-gradient(135deg,var(--c-warm-light),var(--c-warm));color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700;box-shadow:0 8rpx 18rpx rgba(249,115,22,.28)}

/* Hero：暖橙渐变氛围，主操作仍走品牌蓝 */
.hero{position:relative;overflow:hidden;display:flex;align-items:center;margin-top:26rpx;padding:36rpx 32rpx;background:linear-gradient(135deg,#ffb066 0%,#f97316 78%);border-radius:var(--r-card);min-height:230rpx;box-sizing:border-box;box-shadow:0 14rpx 30rpx rgba(249,115,22,.22)}
.hero-copy{position:relative;z-index:2;flex:1}
.hero-title{font-size:34rpx;font-weight:700;color:#fff}
.hero-sub{font-size:22rpx;color:rgba(255,255,255,.88);margin-top:10rpx}
.hero-btn{display:inline-flex;margin-top:26rpx;padding:14rpx 34rpx;border-radius:999rpx;background:#fff;color:#c2410c;font-size:24rpx;font-weight:650;box-shadow:0 7rpx 20rpx rgba(146,64,14,.2)}
.hero-mascot{position:relative;z-index:2;width:190rpx;height:165rpx;margin-right:-6rpx;flex-shrink:0;filter:drop-shadow(0 10rpx 16rpx rgba(146,64,14,.25))}
.bubble{position:absolute;border-radius:50%;background:rgba(255,255,255,.22);z-index:1}
.b1{width:64rpx;height:64rpx;right:186rpx;top:14rpx}
.b2{width:30rpx;height:30rpx;right:30rpx;top:76rpx}
.b3{width:20rpx;height:20rpx;left:22rpx;bottom:16rpx}

.section-title,.recent-title{font-size:29rpx;font-weight:700;color:var(--c-text);margin:30rpx 0 16rpx}

.subject-card{display:flex;align-items:center;padding:24rpx;background:var(--bg-card);border-radius:var(--r-card);margin-bottom:16rpx;box-shadow:var(--shadow-card)}
.subject-icon{width:74rpx;height:74rpx;border-radius:22rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-size:30rpx;font-weight:700;letter-spacing:1rpx}
.subject-card.red .subject-icon{background:linear-gradient(135deg,#ff8f6b,var(--c-chinese));box-shadow:0 8rpx 18rpx rgba(245,108,108,.32)}
.subject-card.blue .subject-icon{background:linear-gradient(135deg,#6ea8ff,var(--c-math));box-shadow:0 8rpx 18rpx rgba(59,130,246,.32)}
.subject-card.green .subject-icon{background:linear-gradient(135deg,#5fd6ad,var(--c-english));box-shadow:0 8rpx 18rpx rgba(16,185,129,.32)}
.subject-copy{flex:1;margin-left:20rpx}
.subject-name{font-size:30rpx;font-weight:650;color:var(--c-text)}
.subject-desc{font-size:21rpx;color:var(--c-text-sub);margin-top:5rpx}
.arrow{font-size:40rpx;color:var(--c-text-faint)}

.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:24rpx}
.quick-item{background:var(--bg-card);border-radius:var(--r-tile);padding:20rpx 6rpx 16rpx;text-align:center;font-size:20rpx;color:var(--c-text-sub);box-shadow:var(--shadow-card);display:flex;flex-direction:column;align-items:center}
.quick-icon{width:56rpx;height:56rpx;margin-bottom:10rpx}

.recent-item{display:flex;align-items:center;background:var(--bg-card);border-radius:var(--r-tile);padding:20rpx;margin-bottom:12rpx;box-shadow:var(--shadow-card)}
.recent-dot{width:12rpx;height:12rpx;border-radius:50%;background:var(--c-primary);margin-right:16rpx}
.recent-info{flex:1;font-size:25rpx;color:var(--c-text)}
.recent-info text{display:block;color:var(--c-text-faint);font-size:20rpx;margin-top:4rpx}
