.page-wrap{min-height:100vh;padding:36rpx 28rpx 60rpx;box-sizing:border-box}.page-title{font-size:44rpx;font-weight:700;color:#0f2b70}.page-sub{font-size:25rpx;color:#64748b;margin:10rpx 0 30rpx}.subject-card{display:flex;align-items:center;padding:30rpx 26rpx;background:#fff;border:2rpx solid #e8eef7;border-radius:24rpx;margin-bottom:18rpx;box-shadow:0 8rpx 24rpx rgba(15,23,42,.05)}.subject-icon{width:88rpx;height:88rpx;border-radius:22rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700}.subject-icon.red{background:#f56c6c}.subject-icon.blue{background:#3b82f6}.subject-icon.green{background:#10b981}.subject-copy{flex:1;margin-left:22rpx}.subject-name{font-size:31rpx;font-weight:650}.subject-desc{font-size:23rpx;color:#64748b;margin-top:8rpx}.arrow{font-size:44rpx;color:#94a3b8}.quick-card{display:flex;align-items:center;justify-content:space-between;margin-top:30rpx;padding:30rpx;background:linear-gradient(135deg,#eff6ff,#e0f2fe);border-radius:24rpx;border:2rpx solid #bfdbfe}.quick-title{font-size:30rpx;font-weight:650;color:#1d4ed8}.quick-desc{font-size:23rpx;color:#64748b;margin-top:8rpx}.quick-btn{padding:14rpx 28rpx;border-radius:999rpx;background:#2687f5;color:#fff;font-size:24rpx}.notice{text-align:center;color:#94a3b8;font-size:22rpx;margin-top:38rpx}
