/* 英语·记词拼单词：词库横选 + 单元勾选 → 记词卡/字母槽位 → 结算。学科绿点缀。 */
.page-wrap{min-height:100vh;padding:32rpx 28rpx 60rpx;box-sizing:border-box}

.head{display:flex;align-items:center;gap:20rpx;margin-bottom:24rpx}
.head-mascot{width:120rpx;height:110rpx;flex-shrink:0}
.head-title{font-size:40rpx;font-weight:700;color:#12305e}
.head-sub{font-size:23rpx;color:var(--c-text-sub);margin-top:6rpx}

.book-scroll{white-space:nowrap;margin-bottom:20rpx}
.book-row{display:inline-flex;gap:12rpx}
.book-chip{padding:12rpx 26rpx;border-radius:999rpx;background:var(--bg-card);color:var(--c-text-sub);font-size:24rpx;box-shadow:var(--shadow-card);flex-shrink:0}
.book-chip.on{background:linear-gradient(135deg,#5fd6ad,var(--c-english));color:#fff;font-weight:600;box-shadow:0 6rpx 16rpx rgba(16,185,129,.3)}

.loading{text-align:center;color:var(--c-text-faint);font-size:24rpx;padding:60rpx 0}

.unit-card{display:flex;align-items:center;gap:18rpx;background:var(--bg-card);border-radius:var(--r-card);padding:24rpx 26rpx;margin-bottom:14rpx;box-shadow:var(--shadow-card);border:3rpx solid transparent}
.unit-card.selected{border-color:var(--c-english);background:linear-gradient(160deg,#f2fbf7,#e4f8ef)}
.unit-check{width:36rpx;height:36rpx;border-radius:50%;border:4rpx solid #d5d0c4;flex-shrink:0;box-sizing:border-box}
.unit-card.selected .unit-check{border-color:var(--c-english);background:var(--c-english);box-shadow:inset 0 0 0 6rpx #fff}
.unit-info{flex:1;min-width:0}
.unit-title{font-size:27rpx;font-weight:600;color:var(--c-text)}
.unit-count{font-size:21rpx;color:var(--c-text-faint);margin-top:6rpx}

.start-bar{position:sticky;bottom:0;display:flex;align-items:center;justify-content:space-between;gap:20rpx;background:var(--bg-page);padding:20rpx 0 calc(10rpx + env(safe-area-inset-bottom))}
.start-info{font-size:23rpx;color:var(--c-text-sub)}
.start-btn{padding:20rpx 44rpx;border-radius:999rpx;background:linear-gradient(135deg,#5fd6ad,var(--c-english));color:#fff;font-size:27rpx;font-weight:600;box-shadow:0 8rpx 18rpx rgba(16,185,129,.3)}

.quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:16rpx}
.back{font-size:26rpx;color:var(--c-text-sub);padding:8rpx 12rpx 8rpx 0}
.progress-text{font-size:25rpx;color:var(--c-text-sub)}
.score-chip{font-size:22rpx;color:#0f766e;background:var(--c-english-soft);border-radius:999rpx;padding:8rpx 20rpx;font-weight:600}
.quiz-right{display:flex;align-items:center;gap:12rpx}
.submit-btn{font-size:22rpx;color:#0f766e;border:2rpx solid currentColor;border-radius:999rpx;padding:4rpx 18rpx}

.progress-bar{height:12rpx;background:#edeae1;border-radius:999rpx;overflow:hidden}
.progress-fill{height:100%;border-radius:999rpx;background:linear-gradient(90deg,#5fd6ad,var(--c-english));transition:width 0.25s}

.memo-card{margin-top:60rpx;background:linear-gradient(160deg,#effcf7,#dcf6ea);border-radius:var(--r-card);padding:64rpx 32rpx;text-align:center;box-shadow:var(--shadow-card)}
.memo-label{font-size:23rpx;color:var(--c-text-sub)}
.memo-word{font-size:88rpx;font-weight:700;color:#14532d;margin-top:20rpx;letter-spacing:2rpx}
.memo-countdown{font-size:22rpx;color:var(--c-text-faint);margin-top:16rpx}
.memo-btn{display:inline-flex;margin-top:34rpx;padding:16rpx 44rpx;border-radius:999rpx;background:linear-gradient(135deg,#5fd6ad,var(--c-english));color:#fff;font-size:26rpx;font-weight:600;box-shadow:0 8rpx 18rpx rgba(16,185,129,.3)}

.peek-line{display:flex;align-items:center;justify-content:center;gap:20rpx;margin-top:36rpx;min-height:56rpx}
.peek-flash{font-size:30rpx;font-weight:600;color:#0f766e}
.peek-btn{font-size:23rpx;color:#0f766e;background:var(--c-english-soft);border-radius:999rpx;padding:10rpx 24rpx}
.peek-btn.empty{color:var(--c-text-faint);background:#f0ede4}

.slot-row{display:flex;flex-wrap:wrap;justify-content:center;gap:14rpx;margin-top:24rpx}
.slot{width:84rpx;height:96rpx;border-radius:16rpx;background:var(--bg-card);border:3rpx solid #e2ddd0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;font-size:48rpx;font-weight:700;color:var(--c-text)}
.slot.filled{border-color:var(--c-english);color:#14532d;background:linear-gradient(160deg,#f2fbf7,#e4f8ef)}

.tile-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:16rpx;margin-top:44rpx}
.tile{width:96rpx;height:96rpx;border-radius:20rpx;background:var(--bg-card);box-shadow:var(--shadow-card);display:flex;align-items:center;justify-content:center;font-size:46rpx;font-weight:700;color:var(--c-text)}
.tile.used{opacity:.25;box-shadow:none;background:#f4f1e9}
.tile.shake{animation:shake .3s}
@keyframes shake{0%,100%{transform:translateX(0)}25%{transform:translateX(-10rpx)}75%{transform:translateX(10rpx)}}
.spell-tip{text-align:center;font-size:22rpx;color:var(--c-text-faint);margin-top:30rpx}

.done-card{margin-top:40rpx;background:var(--bg-card);border-radius:var(--r-card);padding:48rpx 36rpx;text-align:center;box-shadow:var(--shadow-card)}
.done-mascot{width:180rpx;height:160rpx}
.done-stars{font-size:44rpx;margin-top:12rpx}
.done-score{font-size:56rpx;font-weight:750;color:#12305e;margin-top:10rpx}
.done-words{font-size:25rpx;color:var(--c-text-sub);margin-top:10rpx}
.stat-row{display:flex;margin-top:32rpx}
.stat{flex:1}
.stat text{display:block;font-size:38rpx;font-weight:700;color:#0f766e}
.stat label{display:block;font-size:21rpx;color:var(--c-text-faint);margin-top:6rpx}
.done-btns{display:flex;gap:18rpx;margin-top:36rpx}
.done-btn{flex:1;height:88rpx}
