.page-wrap{min-height:100vh;padding:36rpx 28rpx 60rpx;box-sizing:border-box}.page-title{font-size:44rpx;font-weight:700;color:#0f2b70}.page-sub{font-size:25rpx;color:#64748b;margin:10rpx 0 28rpx}.hero{display:flex;justify-content:space-between;align-items:center;padding:30rpx;background:linear-gradient(135deg,#fff7ed,#ffedd5);border-radius:24rpx;margin-bottom:24rpx}.hero-title{font-size:30rpx;font-weight:650;color:#c2410c}.hero-sub{font-size:23rpx;color:#9a6a4b;margin-top:8rpx}.paper{width:82rpx;height:96rpx;background:#fff;border-radius:8rpx;box-shadow:0 8rpx 18rpx rgba(154,80,20,.13);display:flex;align-items:center;justify-content:center;color:#f97316;font-size:21rpx;font-weight:700}.print-card{display:flex;align-items:center;background:#fff;border:2rpx solid #e8eef7;border-radius:22rpx;padding:24rpx;margin-bottom:16rpx}.icon{width:76rpx;height:76rpx;border-radius:18rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700}.red{background:#f56c6c}.blue{background:#3b82f6}.green{background:#10b981}.copy{flex:1;margin-left:20rpx}.name{font-size:29rpx;font-weight:650}.desc{font-size:22rpx;color:#64748b;margin-top:6rpx}.arrow{font-size:42rpx;color:#94a3b8}.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.tool{background:#fff;border:2rpx solid #e8eef7;border-radius:20rpx;padding:24rpx;display:flex;align-items:center;gap:16rpx;font-size:25rpx}.tool-icon{width:58rpx;height:58rpx;border-radius:16rpx;display:flex;align-items:center;justify-content:center;font-weight:700}.red-text{color:#ef4444;background:#fff1f2}.orange{color:#f59e0b;background:#fffbeb}.purple{color:#8b5cf6;background:#f5f3ff}.blue-text{color:#2563eb;background:#eff6ff}
