.page-wrap{min-height:100vh;padding:28rpx 28rpx 60rpx;box-sizing:border-box}.brand-row{display:flex;align-items:center;justify-content:space-between}.brand{font-size:42rpx;font-weight:750;color:#0f2b70;letter-spacing:1rpx}.slogan{font-size:22rpx;color:#64748b;margin-top:4rpx}.brand-mark{width:68rpx;height:68rpx;border-radius:20rpx;background:#dbeafe;color:#2563eb;display:flex;align-items:center;justify-content:center;font-size:34rpx;font-weight:700}.hero{position:relative;overflow:hidden;display:flex;margin-top:26rpx;padding:32rpx;background:linear-gradient(135deg,#eaf8ff,#e5f8ee);border-radius:26rpx;min-height:210rpx;box-sizing:border-box}.hero-copy{position:relative;z-index:2}.hero-title{font-size:31rpx;font-weight:700;color:#164e63}.hero-sub{font-size:22rpx;color:#52717c;margin-top:10rpx}.hero-btn{display:inline-flex;margin-top:28rpx;padding:14rpx 30rpx;border-radius:999rpx;background:#fff;color:#1688f8;font-size:23rpx;font-weight:650;box-shadow:0 7rpx 20rpx rgba(22,136,248,.14)}.hero-art{position:absolute;right:22rpx;bottom:18rpx;width:180rpx;height:160rpx}.book{position:absolute;right:20rpx;bottom:0;width:108rpx;height:122rpx;border-radius:16rpx 24rpx 24rpx 16rpx;background:#fff;color:#f56c6c;display:flex;align-items:center;justify-content:center;font-size:54rpx;font-weight:700;transform:rotate(7deg);box-shadow:0 12rpx 25rpx rgba(15,43,112,.12)}.bubble{position:absolute;border-radius:50%}.b1{width:56rpx;height:56rpx;background:#fde68a;left:5rpx;top:8rpx}.b2{width:32rpx;height:32rpx;background:#93c5fd;right:2rpx;top:0}.section-title,.recent-title{font-size:29rpx;font-weight:700;color:#1f2937;margin:30rpx 0 16rpx}.subject-card{display:flex;align-items:center;padding:22rpx 24rpx;background:#fff;border-radius:22rpx;margin-bottom:15rpx;border:2rpx solid #e8eef7}.subject-icon{width:70rpx;height:70rpx;border-radius:17rpx;color:#fff;display:flex;align-items:center;justify-content:center;font-size:29rpx;font-weight:700}.subject-card.red .subject-icon{background:#f56c6c}.subject-card.blue .subject-icon{background:#3b82f6}.subject-card.green .subject-icon{background:#10b981}.subject-copy{flex:1;margin-left:19rpx}.subject-name{font-size:29rpx;font-weight:650}.subject-desc{font-size:21rpx;color:#64748b;margin-top:5rpx}.arrow{font-size:40rpx;color:#94a3b8}.quick-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12rpx;margin-top:24rpx}.quick-grid>view{background:#fff;border:2rpx solid #e8eef7;border-radius:18rpx;padding:18rpx 6rpx;text-align:center;font-size:20rpx;color:#475569}.quick-icon{width:52rpx;height:52rpx;margin:0 auto 10rpx;border-radius:14rpx;display:flex;align-items:center;justify-content:center;font-weight:700}.blue-text{color:#2563eb;background:#eff6ff}.red-text{color:#ef4444;background:#fff1f2}.orange-text{color:#f59e0b;background:#fffbeb}.purple-text{color:#8b5cf6;background:#f5f3ff}.recent-item{display:flex;align-items:center;background:#fff;border-radius:18rpx;padding:20rpx;margin-bottom:12rpx;border:2rpx solid #e8eef7}.recent-dot{width:12rpx;height:12rpx;border-radius:50%;background:#3b82f6;margin-right:16rpx}.recent-info{flex:1;font-size:25rpx}.recent-info text{display:block;color:#94a3b8;font-size:20rpx;margin-top:4rpx}
