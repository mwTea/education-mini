/* V2 公共视觉令牌：奶油纸底 + 主蓝体系；语红/数蓝/英绿学科色，橙仅作 Hero 氛围。 */
page {
  /* 品牌色 */
  --c-primary: #3b82f6;
  --c-primary-deep: #1688f8;
  --c-primary-ink: #1d4ed8;
  --c-primary-soft: #eff6ff;
  /* 氛围橙（首页 Hero 与轻强调，不作全局主色） */
  --c-warm: #f97316;
  --c-warm-light: #ffa94d;
  --c-warm-soft: #fff3e4;
  /* 学科色 */
  --c-chinese: #f56c6c;
  --c-chinese-soft: #fef2f2;
  --c-math: #3b82f6;
  --c-math-soft: #eff6ff;
  --c-english: #10b981;
  --c-english-soft: #ecfdf5;
  /* 功能色 */
  --c-success: #10b981;
  --c-warn: #f59e0b;
  --c-error: #ef4444;
  /* 中性色（暖纸调） */
  --bg-page: #f7f5f0;
  --bg-card: #ffffff;
  --c-text: #1f2937;
  --c-text-sub: #64748b;
  --c-text-faint: #94a3b8;
  --c-line: #ece5d8;
  /* 圆角与投影 */
  --r-card: 28rpx;
  --r-tile: 20rpx;
  --shadow-card: 0 8rpx 24rpx rgba(64, 48, 22, 0.07);

  background-color: var(--bg-page);
  color: var(--c-text);
  font-size: 28rpx;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
}

button::after {
  border: none;
}

/* 主按钮：品牌蓝渐变 + 投影 */
.btn-primary {
  background: linear-gradient(135deg, var(--c-primary) 0%, var(--c-primary-deep) 100%);
  color: #fff;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(59, 130, 246, 0.24);
}

.btn-ghost {
  background: var(--bg-card);
  color: var(--c-primary);
  border: 2rpx solid #bfdbfe;
  border-radius: 48rpx;
  font-size: 28rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-ghost.danger {
  color: var(--c-error);
  border-color: #fecaca;
}

/* 通用卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--r-card);
  box-shadow: var(--shadow-card);
}

/* 区块标题：色点 + 标题 */
.sec-head {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--c-text);
}

.sec-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 4rpx;
  background: linear-gradient(135deg, var(--c-primary), var(--c-primary-deep));
}

/* 分段控制器 */
.seg {
  display: flex;
  background: #edeae1;
  border-radius: 20rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: var(--c-text-sub);
  border-radius: 16rpx;
  padding: 14rpx 0;
  transition: all 0.2s;
}

.seg-item.on {
  background: var(--bg-card);
  color: var(--c-primary-ink);
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(31, 41, 55, 0.1);
}

/* 迷你田字格（选择器预览用） */
.mini-grid {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border: 3rpx solid #5b9e7d;
  border-radius: 6rpx;
  box-sizing: border-box;
  background: #fff;
}

.mg-v {
  position: absolute;
  left: 50%;
  top: 2rpx;
  bottom: 2rpx;
  border-left: 2rpx dashed #a8cbb6;
}

.mg-h {
  position: absolute;
  top: 50%;
  left: 2rpx;
  right: 2rpx;
  border-top: 2rpx dashed #a8cbb6;
}

.mg-d1,
.mg-d2 {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 96%;
  height: 0;
  border-top: 2rpx dashed #a8cbb6;
  transform: translate(-50%, -50%) rotate(45deg);
}

.mg-d2 {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.mg-fang {
  border-color: #7f878e;
}

.mg-fang .mg-v,
.mg-fang .mg-h {
  border-color: transparent;
}
