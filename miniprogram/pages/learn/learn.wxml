<view class="page-wrap">
  <view class="page-title">选择学科</view>
  <view class="page-sub">沿用现有教材和练习能力，快速开始</view>
  <view class="subject-card" wx:for="{{subjects}}" wx:key="key" data-key="{{item.key}}" bindtap="openSubject">
    <view class="subject-icon {{item.color}}">{{item.icon}}</view>
    <view class="subject-copy"><view class="subject-name">{{item.name}}学习</view><view class="subject-desc">{{item.desc}}</view></view>
    <view class="arrow">›</view>
  </view>
  <view class="quick-card" bindtap="goQuiz">
    <view><view class="quick-title">今日快速练</view><view class="quick-desc">使用上次设置开始在线口算</view></view>
    <view class="quick-btn">开始</view>
  </view>
  <view class="notice">更多语文、英语在线题型将在统一练习版本中开放</view>
</view>
