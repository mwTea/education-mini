/* 数学口算出题主页：独立样式（不 @import 其他页面，避免副作用） */
.page-wrap {
  min-height: 100vh;
  background: #faf4e8;
  padding: 24rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.tip-card {
  background: linear-gradient(135deg, #7cc0dd, #3f92bb);
  border-radius: 24rpx;
  padding: 30rpx 32rpx;
  margin-bottom: 24rpx;
}
.tip-title { color: #fffcf4; font-size: 34rpx; font-weight: 600; }
.tip-sub { color: #e3f4fc; font-size: 22rpx; margin-top: 8rpx; }

.card {
  background: #fffdf6;
  border: 2rpx solid #f0e2cc;
  border-radius: 24rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.sec-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #3a2e25;
}
.sec-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #3f92bb; }
.sec-idx { margin-left: auto; color: #e5d8c3; font-size: 26rpx; font-weight: 600; }

.book-grid { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 24rpx; }
.book-item {
  width: calc((100% - 48rpx) / 4);
  text-align: center; padding: 16rpx 0; font-size: 26rpx; color: #6b5f51;
  background: #fffaf1; border: 2rpx solid #ecd9bd; border-radius: 14rpx;
  box-sizing: border-box;
}
.book-item.on { background: #3f92bb; color: #fff; border-color: #3f92bb; }

.seg { display: flex; background: #f5ecdc; border-radius: 16rpx; padding: 6rpx; margin-top: 24rpx; }
.seg-item {
  flex: 1; text-align: center; font-size: 26rpx; color: #8a7a68;
  padding: 14rpx 0; border-radius: 12rpx;
}
.seg-item.on { background: #fffdf6; color: #3a2e25; font-weight: 600; box-shadow: 0 4rpx 10rpx rgba(150,108,60,0.12); }

.auto-tip { font-size: 22rpx; color: #b3a89d; margin-top: 16rpx; }

.field-label-row {
  display: flex; align-items: center; justify-content: space-between;
  font-size: 26rpx; color: #3a2e25;
}

.btn-primary {
  background: linear-gradient(135deg, #7cc0dd, #3f92bb);
  color: #fff; font-size: 30rpx; font-weight: 600;
  border-radius: 44rpx; border: none;
  display: flex; align-items: center; justify-content: center;
  padding: 4rpx 0; margin: 0;
}
.btn-primary::after { border: none; }
.generate { height: 92rpx; margin-top: 8rpx; }

.quota-tip { text-align: center; color: #c5bab0; font-size: 24rpx; padding: 16rpx 0; }

/* 预留广告位容器（后期接流量主零改版） */
.ad-slot { height: 120rpx; margin-top: 16rpx; }

/* 在线练习大卡 */
.quiz-card {
  display: flex; align-items: center; gap: 20rpx;
  background: linear-gradient(135deg, #7cc0dd, #3f92bb);
  border-radius: 24rpx; padding: 36rpx 32rpx; margin-bottom: 24rpx;
  position: relative; overflow: hidden;
}
.q-title { color: #fffcf4; font-size: 36rpx; font-weight: 700; }
.q-sub { color: #e3f4fc; font-size: 24rpx; margin-top: 10rpx; }
.q-go { color: #fffcf4; font-size: 26rpx; margin-top: 22rpx; font-weight: 600; }
.q-deco { position: absolute; right: 20rpx; bottom: -20rpx; font-size: 150rpx; color: rgba(255,255,255,0.18); }

.dual-btns { display: flex; gap: 20rpx; }
.dual-btns .grow { flex: 1; height: 92rpx; }
.btn-ghost2 { background: none; border: 2rpx solid #3f92bb; color: #2f7fa8; border-radius: 44rpx; font-size: 30rpx; display: flex; align-items: center; justify-content: center; margin: 0; }
.btn-ghost2::after { border: none; }
.practice-links { display: flex; gap: 20rpx; margin-top: 24rpx; }
.practice-links button { flex: 1; margin: 0; padding: 18rpx 8rpx; background: transparent; color: #2f7fa8; font-size: 26rpx; line-height: 1.5; }
.practice-summary { margin-top: 12rpx; font-size: 22rpx; line-height: 1.6; text-align: center; color: #8a7a68; }

/* 错题复习卡片 */
.review-card {
  display: flex; align-items: center; gap: 20rpx;
  background: #fff5ed; border: 2rpx solid #f5d4bc; border-radius: 20rpx;
  padding: 24rpx 26rpx; margin-bottom: 24rpx;
}
.rv-icon {
  width: 60rpx; height: 60rpx; border-radius: 50%;
  background: linear-gradient(135deg, #ff9a76, #e2544e);
  color: #fff; font-size: 28rpx; font-weight: 600;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.rv-info { flex: 1; min-width: 0; }
.rv-title { font-size: 26rpx; font-weight: 600; color: #c04a20; }
.rv-sub { font-size: 22rpx; color: #b3a08b; margin-top: 4rpx; }
.rv-go {
  flex-shrink: 0; background: #e2544e; color: #fff;
  font-size: 24rpx; font-weight: 600; padding: 12rpx 28rpx; border-radius: 30rpx;
}
