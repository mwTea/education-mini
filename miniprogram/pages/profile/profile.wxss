/* 我的页：品牌蓝身份卡（小墨头像）+ 白卡菜单。 */
.page-wrap{min-height:100vh;padding:24rpx 32rpx 60rpx;box-sizing:border-box}
.me-card{display:flex;align-items:center;gap:24rpx;background:linear-gradient(135deg,var(--c-primary),var(--c-primary-ink));border-radius:var(--r-card);padding:36rpx 32rpx;margin-bottom:24rpx;box-shadow:0 12rpx 26rpx rgba(59,130,246,.28)}
.avatar{width:110rpx;height:110rpx;border-radius:50%;background:rgba(255,255,255,.92);display:flex;align-items:center;justify-content:center;overflow:hidden}
.avatar-img{width:96rpx;height:96rpx}
.me-name{color:#fff;font-size:34rpx;font-weight:600}
.me-sub{color:rgba(255,255,255,.85);font-size:22rpx;margin-top:8rpx}
.menu-card{background:var(--bg-card);border-radius:var(--r-card);margin-bottom:24rpx;overflow:hidden;box-shadow:var(--shadow-card)}
.menu-item{display:flex;align-items:center;gap:20rpx;padding:30rpx 32rpx;font-size:28rpx;color:var(--c-text);border-bottom:2rpx solid var(--c-line)}
.menu-item:last-child{border-bottom:none}
.arrow{margin-left:auto;color:var(--c-text-faint)}
.menu-item.contact{background:none;margin:0;padding:30rpx 32rpx;width:100%;text-align:left;border-radius:0;font-size:28rpx;font-weight:400;line-height:1.5;color:var(--c-text);display:flex;justify-content:space-between;font-family:inherit}
.foot-tip{text-align:center;color:var(--c-text-faint);font-size:22rpx;padding:26rpx 0}

/* 年级选择：标签在上，六档通栏一行 */
.grade-block{padding:26rpx 32rpx 30rpx}
.grade-label{font-size:26rpx;color:var(--c-text-sub);margin-bottom:16rpx}
.grade-seg{display:grid;grid-template-columns:repeat(6,1fr);gap:12rpx}
.g-item{text-align:center;padding:14rpx 0;font-size:25rpx;color:var(--c-text-sub);background:#f4f1e9;border-radius:14rpx}
.g-item.on{background:linear-gradient(135deg,var(--c-primary),var(--c-primary-deep));color:#fff;font-weight:600;box-shadow:0 6rpx 14rpx rgba(59,130,246,.28)}
